{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GHL Markdown / Quarto Code Block",
  "scopeName": "markdown.ghl.codeblock",
  "injectionSelector": "L:text.html.markdown, L:source.qmd",
  "patterns": [
    {
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(\\{?\\s*(?:gh|ghl)\\b[^\\}]*\\}?)",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "4": { "name": "fenced_code.block.language.markdown" }
      },
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "endCaptures": {
        "3": { "name": "punctuation.definition.markdown" }
      },
      "contentName": "source.ghl",
      "patterns": [
        { "include": "source.ghl" }
      ]
    }
  ]
}
