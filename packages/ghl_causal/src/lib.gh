// ghl_causal :: Main Library Module (RFC 15 Parte E)
// Advanced Causal Inference for GHL: Staggered DiD, Event Studies, Goodman-Bacon,
// Synthetic Control, Doubly Robust Estimators, Instrumental Variables (2SLS), and Sensitivity Refutations.

struct CausalAudit {
    did_result: DidResult,
    parallel_trends: ParallelTrendsResult,
    event_study: EventStudyResult,
    is_fully_certified: bool
}

/// Orchestrates an end-to-end 2x2 causal audit:
/// 1. Verifies parallel pre-trends assumption before intervention
/// 2. Estimates canonical 2x2 DiD Treatment Effect (ATT)
/// 3. Computes dynamic event study trajectory across relative periods
fn audit_causal_pipeline(df: DataFrame, outcome_col: String, treat_col: String, post_col: String, time_col: String, cutoff_time: f64) -> CausalAudit {
    let pt_res = test_parallel_trends(df, outcome_col, treat_col, time_col, cutoff_time);
    let did_res = did_2x2(df, outcome_col, treat_col, post_col);
    let es_res = event_study(df, outcome_col, treat_col, time_col, cutoff_time);

    let certified = pt_res.is_validated && did_res.is_significant && es_res.pre_trends_pass;

    CausalAudit {
        did_result: did_res,
        parallel_trends: pt_res,
        event_study: es_res,
        is_fully_certified: certified
    }
}

/// Builds the final causal audit summary panel.
fn causal_audit_cockpit(audit: CausalAudit) {
    let badge = if audit.is_fully_certified {
        "/ᐠ˵- ⩊ -˵マ ✧ CAUSAL CERTIFIED"
    } else {
        "≽(◉˕ ◉ ≼マ CAUTION ADVISED"
    };

    let pt_status = if audit.parallel_trends.is_validated { "VALIDATED (p >= 0.05)" } else { "VIOLATION SUSPECTED" };
    let es_status = if audit.event_study.pre_trends_pass { "PASSED (null holds)" } else { "NON-ZERO LEADS DETECTED" };

    let p = cockpit("GHL Causal: Final Causal Inference Certification", badge)
        |> cockpit_add_kv("Parallel Trends", pt_status)
        |> cockpit_add_kv("Treatment Effect (ATT)", format("{:.4} (p = {:.4})", audit.did_result.att, audit.did_result.p_value))
        |> cockpit_add_kv("Event Study Leads", es_status)
        |> cockpit_add_divider();

    if audit.is_fully_certified {
        p |> cockpit_add_line("/ᐠ˵- ⩊ -˵マ ✧ CAUSAL PIPELINE CERTIFIED: Robust causal identification confirmed!")
    } else {
        p |> cockpit_add_line("≽(◉˕ ◉ ≼マ CAUSAL AUDIT CAUTION: Review assumption warnings above before policy inference")
    }
}

/// Renders the full causal audit report.
fn render_causal_audit(audit: CausalAudit) {
    render_parallel_trends_cockpit(audit.parallel_trends);
    render_did_cockpit(audit.did_result);
    render_event_study_cockpit(audit.event_study);

    let summary = causal_audit_cockpit(audit);
    show_cockpit(summary);
}

/// High-level audit for Callaway & Sant'Anna (2021) Staggered DiD.
fn audit_staggered_did(df: DataFrame, outcome_col: String, unit_col: String, time_col: String, cohort_col: String) -> CsDidResult {
    let res = cs_did(df, outcome_col, unit_col, time_col, cohort_col);
    render_cs_did_cockpit(res);
    res
}

/// High-level audit for Goodman-Bacon (2021) TWFE decomposition.
fn audit_bacon_decomposition(df: DataFrame, outcome_col: String, unit_col: String, time_col: String, cohort_col: String) -> BaconDecompositionResult {
    let res = bacon_decompose(df, outcome_col, unit_col, time_col, cohort_col);
    render_bacon_cockpit(res);
    res
}

/// High-level audit for Synthetic Control Method (Abadie et al. 2010).
fn audit_synthetic_control_analysis(df: DataFrame, outcome_col: String, unit_col: String, time_col: String, treated_unit: f64, cutoff_time: f64) -> SyntheticControlResult {
    let res = synthetic_control(df, outcome_col, unit_col, time_col, treated_unit, cutoff_time);
    render_scm_cockpit(res);
    res
}

/// High-level audit for Doubly Robust DiD (Sant'Anna & Zhao 2020).
fn audit_doubly_robust_analysis(df: DataFrame, delta_y_col: String, treat_col: String, cov_cols: Vector) -> DoublyRobustDidResult {
    let res = did_doubly_robust(df, delta_y_col, treat_col, cov_cols);
    render_doubly_robust_cockpit(res);
    res
}

/// High-level audit for Instrumental Variables 2SLS (Angrist-Imbens LATE).
fn audit_iv_analysis(df: DataFrame, outcome_col: String, treat_col: String, instrument_col: String) -> Iv2slsResult {
    let res = iv_2sls(df, outcome_col, treat_col, instrument_col);
    render_iv_cockpit(res);
    res
}
