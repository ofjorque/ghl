// packages/ghl_causal/src/synthetic_control.gh
// Synthetic Control Method (SCM) - Abadie, Diamond & Hainmueller (2010)
// Convex optimization over donor pool units with in-space placebo permutation inference.

/// Single donor unit weight in synthetic counterfactual.
struct ScmDonorWeight {
    donor_id: f64,
    weight: f64
}

/// Trajectory point at calendar period t comparing actual vs synthetic control.
struct ScmTrajectoryPoint {
    time: f64,
    actual: f64,
    synthetic: f64,
    effect: f64,      // actual - synthetic
    is_post: bool
}

/// Results of Synthetic Control Method (SCM) estimation and placebo inference.
struct SyntheticControlResult {
    treated_unit_id: f64,
    donor_weights: Vector,          // Vector of ScmDonorWeight
    trajectory: Vector,             // Vector of ScmTrajectoryPoint
    pre_rmspe: f64,                 // Pre-intervention Root Mean Squared Prediction Error
    post_rmspe: f64,                // Post-intervention RMSPE
    rmspe_ratio: f64,               // post_rmspe / pre_rmspe
    average_att: f64,               // Mean treatment effect over post-intervention period
    placebo_p_value: f64,           // In-space permutation p-value from donor pool placebos
    placebo_rmspe_ratios: Vector,   // RMSPE ratios for all donors
    is_significant: bool            // True if placebo_p_value < 0.05 or lowest in donor pool
}

/// Solves constrained convex quadratic weights w >= 0, sum(w) = 1 matching target vector y_target
/// from donor matrix X_donors (T_pre rows, J columns) using projected coordinate descent.
fn solve_scm_weights(
    y_target: Vector,
    donor_matrix: Vector, // flattened T_pre x J matrix (row-major: time t * J + donor j)
    t_pre: i64,
    n_donors: i64
) -> Vector {
    let fn_donors = 0.0 + n_donors;
    let mut weights = [];
    for j in 0..n_donors {
        weights = append(weights, 1.0 / fn_donors);
    }

    let max_iter = 250;
    let eta = 0.40;

    for iter in 0..max_iter {
        // Compute synthetic prediction: y_hat[t] = sum_j w[j] * donor_matrix[t * J + j]
        let mut residuals = [];
        for t in 0..t_pre {
            let mut y_hat_t = 0.0;
            for j in 0..n_donors {
                let x_tj = donor_matrix[(t * n_donors) + j];
                y_hat_t = y_hat_t + (weights[j] * x_tj);
            }
            residuals = append(residuals, y_hat_t - y_target[t]);
        }

        // Compute gradient with respect to each weight: grad_w[j] = sum_t residuals[t] * x_tj
        let mut max_abs_g = 0.0001;
        let mut grad_w = [];
        for j in 0..n_donors {
            let mut g_j = 0.0;
            for t in 0..t_pre {
                let x_tj = donor_matrix[(t * n_donors) + j];
                g_j = g_j + (residuals[t] * x_tj);
            }
            if abs(g_j) > max_abs_g {
                max_abs_g = abs(g_j);
            }
            grad_w = append(grad_w, g_j);
        }

        // Exponentiated gradient step on the simplex (Mirror Descent)
        let mut unnorm_w = [];
        let mut sum_unnorm = 0.0;
        for j in 0..n_donors {
            let scaled_g = clamp(grad_w[j] / max_abs_g, -4.0, 4.0);
            let factor = exp(-eta * scaled_g);
            let nw = weights[j] * factor;
            unnorm_w = append(unnorm_w, nw);
            sum_unnorm = sum_unnorm + nw;
        }

        if sum_unnorm > 0.0 {
            for j in 0..n_donors {
                weights = set(weights, j, unnorm_w[j] / sum_unnorm);
            }
        }
    }


    weights
}

/// Estimates Synthetic Control Method (SCM) for comparative case studies.
///
/// Optimizes convex combination of untreated donor pool units to match the pre-treatment
/// trajectory of the treated unit. Automatically conducts in-space placebo permutation
/// tests across all donor units to derive exact non-parametric p-values (Abadie et al. 2010).
///
/// @param df Panel DataFrame containing unit, time, outcome y
/// @param outcome_col Outcome variable name
/// @param unit_col Unit identifier column name
/// @param time_col Time period column name
/// @param treated_unit Unit identifier of the treated entity
/// @param cutoff_time Intervention start period (post-treatment begins at time >= cutoff_time)
/// @return SyntheticControlResult with donor weights, trajectory, RMSPE, and permutation p-value
fn synthetic_control(
    df: DataFrame,
    outcome_col: String,
    unit_col: String,
    time_col: String,
    treated_unit: f64,
    cutoff_time: f64
) -> SyntheticControlResult {
    let y_vals = pull(df, outcome_col);
    let u_vals = pull(df, unit_col);
    let t_vals = pull(df, time_col);
    let n = length(y_vals);

    // Identify unique periods and unique donor units
    let mut periods = [];
    let mut donors = [];

    for i in 0..n {
        let t = t_vals[i];
        let mut found_t = false;
        for pt in periods {
            if pt == t { found_t = true; }
        }
        if !found_t { periods = append(periods, t); }

        let u = u_vals[i];
        if u != treated_unit {
            let mut found_u = false;
            for du in donors {
                if du == u { found_u = true; }
            }
            if !found_u { donors = append(donors, u); }
        }
    }

    periods = sort(periods);
    donors = sort(donors);

    let n_periods = length(periods);
    let n_donors = length(donors);

    // Split pre-treatment and post-treatment periods
    let mut pre_periods = [];
    let mut post_periods = [];
    for t in periods {
        if t < cutoff_time {
            pre_periods = append(pre_periods, t);
        } else {
            post_periods = append(post_periods, t);
        }
    }

    let t_pre = length(pre_periods);
    let t_post = length(post_periods);

    if t_pre < 2 {
        panic("Synthetic Control requires at least 2 pre-intervention periods.");
    }
    if n_donors < 2 {
        panic("Synthetic Control requires at least 2 donor units in the comparison pool.");
    }

    // Helper lookup closure/loop for unit u at period t
    let mut y_treated_pre = [];
    for tp in pre_periods {
        let mut val = 0.0;
        for i in 0..n {
            if u_vals[i] == treated_unit && t_vals[i] == tp {
                val = y_vals[i];
            }
        }
        y_treated_pre = append(y_treated_pre, val);
    }

    // Build donor matrix for pre-period: T_pre x N_donors
    let mut donor_matrix_pre = [];
    for tp in pre_periods {
        for du in donors {
            let mut val = 0.0;
            for i in 0..n {
                if u_vals[i] == du && t_vals[i] == tp {
                    val = y_vals[i];
                }
            }
            donor_matrix_pre = append(donor_matrix_pre, val);
        }
    }

    // Solve optimal donor weights for treated unit
    let weights = solve_scm_weights(y_treated_pre, donor_matrix_pre, t_pre, n_donors);

    let mut donor_weights_list = [];
    for j in 0..n_donors {
        let w_val = weights[j];
        if w_val > 0.001 { // retain non-zero weights
            donor_weights_list = append(donor_weights_list, ScmDonorWeight { donor_id: donors[j], weight: w_val });
        }
    }

    // Compute actual vs synthetic trajectory for all periods
    let mut trajectory = [];
    let mut ssq_pre = 0.0;
    let mut ssq_post = 0.0;
    let mut sum_att_post = 0.0;

    for t in periods {
        let is_post = t >= cutoff_time;

        let mut actual_y = 0.0;
        for i in 0..n {
            if u_vals[i] == treated_unit && t_vals[i] == t {
                actual_y = y_vals[i];
            }
        }

        let mut synth_y = 0.0;
        for j in 0..n_donors {
            let du = donors[j];
            let mut val_j = 0.0;
            for i in 0..n {
                if u_vals[i] == du && t_vals[i] == t {
                    val_j = y_vals[i];
                }
            }
            synth_y = synth_y + (weights[j] * val_j);
        }

        let eff = actual_y - synth_y;
        let pt = ScmTrajectoryPoint {
            time: t,
            actual: actual_y,
            synthetic: synth_y,
            effect: eff,
            is_post: is_post
        };
        trajectory = append(trajectory, pt);

        if is_post {
            ssq_post = ssq_post + (eff * eff);
            sum_att_post = sum_att_post + eff;
        } else {
            ssq_pre = ssq_pre + (eff * eff);
        }
    }

    let pre_rmspe = sqrt(ssq_pre / (0.0 + t_pre));
    let post_rmspe = sqrt(ssq_post / (0.0 + t_post));
    let rmspe_ratio = if pre_rmspe > 0.0001 { post_rmspe / pre_rmspe } else { 999.0 };
    let avg_att = sum_att_post / (0.0 + t_post);

    // In-space placebo test: estimate SCM for each donor unit j pretending it was treated
    let mut placebo_ratios = [];
    let mut count_extreme = 0.0;

    for d_idx in 0..n_donors {
        let p_target_u = donors[d_idx];

        // Other donors as comparison pool
        let mut p_donors = [treated_unit];
        for k in 0..n_donors {
            if k != d_idx {
                p_donors = append(p_donors, donors[k]);
            }
        }

        let mut p_y_target_pre = [];
        for tp in pre_periods {
            let mut val = 0.0;
            for i in 0..n {
                if u_vals[i] == p_target_u && t_vals[i] == tp { val = y_vals[i]; }
            }
            p_y_target_pre = append(p_y_target_pre, val);
        }

        let mut p_donor_mat = [];
        for tp in pre_periods {
            for du in p_donors {
                let mut val = 0.0;
                for i in 0..n {
                    if u_vals[i] == du && t_vals[i] == tp { val = y_vals[i]; }
                }
                p_donor_mat = append(p_donor_mat, val);
            }
        }

        let p_weights = solve_scm_weights(p_y_target_pre, p_donor_mat, t_pre, length(p_donors));

        let mut p_ssq_pre = 0.0;
        let mut p_ssq_post = 0.0;

        for t in periods {
            let mut act = 0.0;
            for i in 0..n {
                if u_vals[i] == p_target_u && t_vals[i] == t { act = y_vals[i]; }
            }

            let mut syn = 0.0;
            for k in 0..length(p_donors) {
                let du = p_donors[k];
                let mut val_k = 0.0;
                for i in 0..n {
                    if u_vals[i] == du && t_vals[i] == t { val_k = y_vals[i]; }
                }
                syn = syn + (p_weights[k] * val_k);
            }

            let d_eff = act - syn;
            if t >= cutoff_time {
                p_ssq_post = p_ssq_post + (d_eff * d_eff);
            } else {
                p_ssq_pre = p_ssq_pre + (d_eff * d_eff);
            }
        }

        let p_pre_r = sqrt(p_ssq_pre / (0.0 + t_pre));
        let p_post_r = sqrt(p_ssq_post / (0.0 + t_post));
        let p_ratio = if p_pre_r > 0.0001 { p_post_r / p_pre_r } else { 0.0 };

        placebo_ratios = append(placebo_ratios, p_ratio);
        if p_ratio >= rmspe_ratio {
            count_extreme = count_extreme + 1.0;
        }
    }

    // Exact permutation p-value: (1 + count_extreme) / (1 + N_donors)
    let total_entities = 1.0 + (0.0 + n_donors);
    let p_val_scm = (1.0 + count_extreme) / total_entities;
    let is_sig = p_val_scm <= 0.20 || rmspe_ratio >= 3.0; // Significant or pronounced ratio

    SyntheticControlResult {
        treated_unit_id: treated_unit,
        donor_weights: donor_weights_list,
        trajectory: trajectory,
        pre_rmspe: pre_rmspe,
        post_rmspe: post_rmspe,
        rmspe_ratio: rmspe_ratio,
        average_att: avg_att,
        placebo_p_value: p_val_scm,
        placebo_rmspe_ratios: placebo_ratios,
        is_significant: is_sig
    }
}

/// Builds visual Cockpit Deck panel for Synthetic Control Method.
fn scm_cockpit(res: SyntheticControlResult) {
    let badge = if res.is_significant {
        "/ᐠ˵- ⩊ -˵マ ✧ SYNTHETIC CONTROL SIGNIFICANT"
    } else {
        "≽(◉˕ ◉ ≼マ INSUFFICIENT EVIDENCE"
    };

    let mut p = cockpit("GHL Causal: Synthetic Control Method (Abadie et al. 2010)", badge)
        |> cockpit_add_kv("Treated Unit ID", format("{:.0}", res.treated_unit_id))
        |> cockpit_add_kv("Pre-Intervention RMSPE", format("{:.4}", res.pre_rmspe))
        |> cockpit_add_kv("Post-Intervention RMSPE", format("{:.4}", res.post_rmspe))
        |> cockpit_add_kv("RMSPE Ratio (Post / Pre)", format("{:.2}x", res.rmspe_ratio))
        |> cockpit_add_kv("Average Post-Treatment ATT", format("{:.4}", res.average_att))
        |> cockpit_add_kv("In-Space Placebo p-value", format("{:.4}", res.placebo_p_value))
        |> cockpit_add_divider()
        |> cockpit_add_line("Top Active Donor Units & Convex Weights (w >= 0, Σw = 1):")
        |> cockpit_add_divider();

    for dw in res.donor_weights {
        let pct = dw.weight * 100.0;
        let line = format("Donor Unit {:<6}  Weight: {:>6.2}%", dw.donor_id, pct);
        p = cockpit_add_line(p, line);
    }

    p = cockpit_add_divider(p);
    if res.is_significant {
        p |> cockpit_add_line("/ᐠ˵- ⩊ -˵マ ✧ Placebo permutation test confirms policy intervention effect is unprecedented.")
    } else {
        p |> cockpit_add_line("≽(◉˕ ◉ ≼マ Post-treatment deviation is within the range of untreated placebo donor variations.")
    }
}

/// Renders visual Cockpit Deck panel for Synthetic Control Method to terminal.
fn render_scm_cockpit(res: SyntheticControlResult) {
    let p = scm_cockpit(res);
    show_cockpit(p);
}
