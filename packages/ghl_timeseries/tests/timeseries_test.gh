// Integration test suite for ghl_timeseries package (RFC 15 Parte E)

println("Running ghl_timeseries integration test suite...");

// 1. Test Differencing
let test_seq = [10.0, 12.0, 15.0, 19.0, 24.0];
let d1 = diff_series(test_seq, 1);
println("First Difference:", d1);
if length(d1) != 4 {
    panic("First difference length should be n - 1");
}
if d1[0] != 2.0 || d1[1] != 3.0 || d1[2] != 4.0 || d1[3] != 5.0 {
    panic("Incorrect difference values");
}

// 2. Test 1D State-Space Kalman Filter
let noisy_signal = [
    10.1, 10.5, 11.2, 11.8, 12.1, 12.9, 13.4, 13.8, 14.5, 15.1,
    15.6, 16.2, 16.8, 17.4, 18.0, 18.5, 19.1, 19.8, 20.2, 20.9
];

let k_res = kalman_filter_1d(noisy_signal, 1.0, 1.0, 0.05, 0.20, 10.0, 1.0);
render_kalman_cockpit(k_res);

if !k_res.is_converged {
    panic("Kalman filter should converge on stable tracking series");
}
if k_res.final_state < 19.0 || k_res.final_state > 22.0 {
    panic("Final estimated state outside expected trajectory bounds");
}
if k_res.filtered_mse >= k_res.pred_mse {
    panic("Filtered state error should improve upon a priori prediction error");
}

// 3. Test Autoregressive ARIMA(1, 0, 0)
let ar1_series = [
    2.1, 1.8, 2.5, 3.2, 2.9, 3.8, 4.1, 3.9, 4.5, 5.0,
    4.8, 5.5, 5.9, 5.6, 6.2, 6.8, 6.5, 7.1, 7.5, 7.9
];

let ar_res = fit_arima(ar1_series, 1, 0, 0);
render_arima_cockpit(ar_res);

if !ar_res.is_stationary {
    panic("AR(1) model should satisfy stationarity conditions");
}
if length(ar_res.ar_coeffs) != 1 {
    panic("AR(1) model should return exactly 1 AR coefficient");
}
let phi1 = ar_res.ar_coeffs[0];
println("Estimated AR(1) phi:", phi1);
if phi1 <= 0.0 || phi1 >= 1.2 {
    panic("Estimated autoregressive parameter out of plausible range");
}

// Test multi-step forecast
let fc = forecast_arima(ar_res, ar1_series, 3);
println("3-Step Forecast:", fc);
if length(fc) != 3 {
    panic("Forecast should return requested 3 steps ahead");
}

// 4. Test GARCH(1, 1) Volatility Modeling
let financial_returns = [
    0.012, -0.015, 0.008, -0.022, 0.035, -0.041, 0.028, -0.019,
    0.005, -0.007, 0.011, -0.014, 0.009, -0.006, 0.004, -0.018,
    0.025, -0.031, 0.019, -0.012, 0.008, -0.005, 0.003, -0.009
];

let garch_res = fit_garch(financial_returns);
render_garch_cockpit(garch_res);

if !garch_res.is_stationary {
    panic("GARCH model on bounded returns should be stationary");
}
if garch_res.persistence >= 1.0 {
    panic("Persistence alpha + beta must be strictly less than 1.0 for covariance stationarity");
}
if garch_res.long_run_vol <= 0.0 {
    panic("Long-run volatility must be positive");
}

// 5. Test Full End-to-End Pipeline
let audit = audit_timeseries_pipeline(ar1_series, 1, 0, 0);
render_timeseries_report(audit);

if !audit.is_fully_certified {
    panic("Integrated time series pipeline should be fully certified");
}

println("All ghl_timeseries tests passed successfully! /ᐠ˵- ⩊ -˵マ ✧");
