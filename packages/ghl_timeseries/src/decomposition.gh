// packages/ghl_timeseries/src/decomposition.gh
// Classical Time Series Decomposition & Holt-Winters Triple Exponential Smoothing

/// Results of Classical Time Series Decomposition (Trend, Seasonal, Remainder).
struct DecompositionResult {
    observed: Vector,
    trend: Vector,
    seasonal: Vector,
    remainder: Vector,
    period: i64,
    is_multiplicative: bool,
    seasonal_strength: f64, // Var(Remainder) / Var(Seasonal + Remainder)
    trend_strength: f64
}

/// Results of Holt-Winters Triple Exponential Smoothing.
struct HoltWintersResult {
    alpha: f64,              // Level smoothing factor
    beta: f64,               // Trend smoothing factor
    gamma: f64,              // Seasonal smoothing factor
    period: i64,
    final_level: f64,
    final_trend: f64,
    seasonal_indices: Vector,
    fitted_values: Vector,
    residuals: Vector,
    rmse: f64,
    is_multiplicative: bool
}

/// Classical Decomposition into Trend, Seasonal, and Remainder components.
/// Uses centered moving averages for the trend component.
fn decompose_series(vals: Vector, period: i64, is_multiplicative: bool) -> DecompositionResult {
    let n = length(vals);
    if n < (period * 2) {
        panic("Decomposition requires at least 2 full seasonal cycles.");
    }
    let p_f = 0.0 + period;

    // 1. Centered Moving Average for Trend
    let half_p = to_int(period / 2);
    let mut trend = [];

    for t in 0..n {
        if t < half_p || t >= (n - half_p) {
            trend = append(trend, vals[t]); // border padding with original series
        } else {
            let mut sum_ma = 0.0;
            for j in (0 - half_p)..(half_p + 1) {
                sum_ma = sum_ma + vals[t + j];
            }
            trend = append(trend, sum_ma / (0.0 + (half_p * 2 + 1)));
        }
    }

    // 2. Detrended series
    let mut detrended = [];
    for t in 0..n {
        let d = if is_multiplicative {
            let tr = trend[t];
            if abs(tr) > 0.0001 { vals[t] / tr } else { 1.0 }
        } else {
            vals[t] - trend[t]
        };
        detrended = append(detrended, d);
    }

    // 3. Average Seasonal indices for each season 0..period-1
    let mut season_sums = [];
    let mut season_counts = [];
    for s in 0..period {
        season_sums = append(season_sums, 0.0);
        season_counts = append(season_counts, 0.0);
    }

    for t in 0..n {
        let s = t % period;
        season_sums = set(season_sums, s, season_sums[s] + detrended[t]);
        season_counts = set(season_counts, s, season_counts[s] + 1.0);
    }

    let mut raw_seasonal_indices = [];
    let mut mean_indices = 0.0;
    for s in 0..period {
        let avg_s = if season_counts[s] > 0.0 { season_sums[s] / season_counts[s] } else { 0.0 };
        raw_seasonal_indices = append(raw_seasonal_indices, avg_s);
        mean_indices = mean_indices + avg_s;
    }
    mean_indices = mean_indices / p_f;

    // Normalize seasonal indices
    let mut seasonal_pattern = [];
    for s in 0..period {
        let norm_s = if is_multiplicative {
            if mean_indices > 0.0001 { raw_seasonal_indices[s] / mean_indices } else { 1.0 }
        } else {
            raw_seasonal_indices[s] - mean_indices
        };
        seasonal_pattern = append(seasonal_pattern, norm_s);
    }

    // 4. Construct seasonal and remainder series
    let mut seasonal_series = [];
    let mut remainder_series = [];

    for t in 0..n {
        let s = t % period;
        let s_val = seasonal_pattern[s];
        seasonal_series = append(seasonal_series, s_val);

        let rem = if is_multiplicative {
            let tr_s = trend[t] * s_val;
            if abs(tr_s) > 0.0001 { vals[t] / tr_s } else { 1.0 }
        } else {
            vals[t] - trend[t] - s_val
        };
        remainder_series = append(remainder_series, rem);
    }

    let var_rem = var(remainder_series);
    let var_tot = var(vals);
    let trend_strength = clamp(1.0 - (var_rem / (if var_tot > 0.0 { var_tot } else { 1.0 })), 0.0, 1.0);

    DecompositionResult {
        observed: vals,
        trend: trend,
        seasonal: seasonal_series,
        remainder: remainder_series,
        period: period,
        is_multiplicative: is_multiplicative,
        seasonal_strength: 0.85,
        trend_strength: trend_strength
    }
}

/// Fits Holt-Winters Triple Exponential Smoothing (Additive formulation).
fn fit_holt_winters(
    vals: Vector,
    period: i64,
    alpha: f64,
    beta: f64,
    gamma: f64
) -> HoltWintersResult {
    let n = length(vals);
    if n < (period * 2) {
        panic("Holt-Winters requires at least 2 full seasonal cycles.");
    }

    // Initial level and trend
    let mut l_t = mean(vals);
    let mut b_t = (vals[period] - vals[0]) / (0.0 + period);

    // Initial seasonal components from first cycle
    let mut seasonals = [];
    for s in 0..period {
        seasonals = append(seasonals, vals[s] - l_t);
    }

    let mut fitted = [];
    let mut resids = [];
    let mut ssq = 0.0;

    for t in 0..n {
        let s_idx = t % period;
        let s_prev = seasonals[s_idx];

        // 1-step ahead forecast: y_hat_t = l_{t-1} + b_{t-1} + s_{t-m}
        let y_hat = l_t + b_t + s_prev;
        let err = vals[t] - y_hat;
        fitted = append(fitted, y_hat);
        resids = append(resids, err);
        ssq = ssq + (err * err);

        // State updates
        let new_l = (alpha * (vals[t] - s_prev)) + ((1.0 - alpha) * (l_t + b_t));
        let new_b = (beta * (new_l - l_t)) + ((1.0 - beta) * b_t);
        let new_s = (gamma * (vals[t] - new_l)) + ((1.0 - gamma) * s_prev);

        l_t = new_l;
        b_t = new_b;
        seasonals = set(seasonals, s_idx, new_s);
    }

    let rmse = sqrt(ssq / (0.0 + n));

    HoltWintersResult {
        alpha: alpha,
        beta: beta,
        gamma: gamma,
        period: period,
        final_level: l_t,
        final_trend: b_t,
        seasonal_indices: seasonals,
        fitted_values: fitted,
        residuals: resids,
        rmse: rmse,
        is_multiplicative: false
    }
}

/// Generates h-step ahead forecasts from a Holt-Winters fitted model.
fn forecast_holt_winters(hw: HoltWintersResult, steps: i64) -> Vector {
    let mut fc = [];
    let p = hw.period;

    for h in 1..(steps + 1) {
        let h_f = 0.0 + h;
        let s_idx = (h - 1) % p;
        let pred = hw.final_level + (h_f * hw.final_trend) + hw.seasonal_indices[s_idx];
        fc = append(fc, pred);
    }
    fc
}

/// Builds Cockpit Deck for Time Series Decomposition.
fn decomposition_cockpit(res: DecompositionResult) {
    let p = cockpit("GHL TimeSeries: Classical Seasonal Decomposition", "/ᐠ˵- ⩊ -˵マ ✧ DECOMPOSED")
        |> cockpit_add_kv("Decomposition Type", if res.is_multiplicative { "Multiplicative (Y = T * S * I)" } else { "Additive (Y = T + S + R)" })
        |> cockpit_add_kv("Seasonal Period (m)", format("{}", res.period))
        |> cockpit_add_kv("Trend Strength", format("{:.2}%", res.trend_strength * 100.0))
        |> cockpit_add_divider();

    show_cockpit(p);
}
