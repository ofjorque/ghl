// spring_pact :: Data Expectation Rules Module (RFC 14)
// Defines data sanitation, validation, range, missingness, outlier, uniqueness, and schema protocols.

struct RangeRule {
    col_name: String,
    min_val: f64,
    max_val: f64
}

struct NaRule {
    col_name: String,
    threshold: f64
}

struct OutlierRule {
    col_name: String,
    method: String,
    factor: f64
}

struct UniqueRule {
    col_name: String
}

struct ColumnSchemaRule {
    expected_cols: Vector
}

fn create_range_rule(col_name: String, min_val: f64, max_val: f64) -> RangeRule {
    RangeRule {
        col_name: col_name,
        min_val: min_val,
        max_val: max_val
    }
}

fn create_na_rule(col_name: String, threshold: f64) -> NaRule {
    NaRule {
        col_name: col_name,
        threshold: threshold
    }
}

fn create_outlier_rule(col_name: String, method: String, factor: f64) -> OutlierRule {
    OutlierRule {
        col_name: col_name,
        method: method,
        factor: factor
    }
}

fn create_unique_rule(col_name: String) -> UniqueRule {
    UniqueRule { col_name: col_name }
}

fn create_column_schema_rule(expected_cols: Vector) -> ColumnSchemaRule {
    ColumnSchemaRule { expected_cols: expected_cols }
}

/// Evaluates whether a column's values satisfy the range expectation [min_val, max_val].
fn evaluate_range_rule(rule: RangeRule, df: DataFrame) -> RuleEvaluation {
    let col_data = pull(df, rule.col_name);
    let c_min = min(col_data);
    let c_max = max(col_data);

    let passed = c_min >= rule.min_val && c_max <= rule.max_val;
    let exp_str = format("[{}, {}]", rule.min_val, rule.max_val);
    let obs_str = format("min = {}, max = {}", c_min, c_max);

    RuleEvaluation {
        rule: format("Range check on `{}`", rule.col_name),
        expected: exp_str,
        observed: obs_str,
        passed: passed
    }
}

/// Evaluates whether a column's missing values proportion is below the threshold.
fn evaluate_na_rule(rule: NaRule, df: DataFrame) -> RuleEvaluation {
    let col_data = pull(df, rule.col_name);
    let total_n = length(col_data);
    let na_count = sum(is_na(col_data));
    let na_ratio = (na_count * 1.0) / (total_n * 1.0);

    let passed = na_ratio <= rule.threshold;
    let exp_str = format("NA proportion <= {:.2}%", rule.threshold * 100.0);
    let obs_str = format("{:.2}% ({} / {})", na_ratio * 100.0, na_count, total_n);

    RuleEvaluation {
        rule: format("NA threshold on `{}`", rule.col_name),
        expected: exp_str,
        observed: obs_str,
        passed: passed
    }
}

/// Evaluates whether a column has outliers according to IQR (factor * IQR) or Z-score rule.
fn evaluate_outlier_rule(rule: OutlierRule, df: DataFrame) -> RuleEvaluation {
    let col_data = pull(df, rule.col_name);
    let clean = filter_na(col_data);
    let q25 = quantile(clean, 0.25);
    let q75 = quantile(clean, 0.75);
    let col_iqr = q75 - q25;

    let lower_bound = q25 - rule.factor * col_iqr;
    let upper_bound = q75 + rule.factor * col_iqr;

    let mut outliers_count = 0;
    for v in col_data {
        if v < lower_bound || v > upper_bound {
            outliers_count = outliers_count + 1;
        }
    }
    let passed = outliers_count == 0;

    let exp_str = format("0 outliers via {} (factor = {})", rule.method, rule.factor);
    let obs_str = format("{} outliers detected outside [{:.2}, {:.2}]", outliers_count, lower_bound, upper_bound);

    RuleEvaluation {
        rule: format("Outlier check on `{}`", rule.col_name),
        expected: exp_str,
        observed: obs_str,
        passed: passed
    }
}

/// Evaluates uniqueness of entries in a primary key or identifier column.
fn evaluate_unique_rule(rule: UniqueRule, df: DataFrame) -> RuleEvaluation {
    let col_data = pull(df, rule.col_name);
    let n_total = length(col_data);
    let mut has_dups = false;

    for i in 0..n_total {
        for j in (i + 1)..n_total {
            if col_data[i] == col_data[j] {
                has_dups = true;
            }
        }
    }

    let passed = !has_dups;
    let exp_str = "Zero duplicate values";
    let obs_str = if passed { "All values unique" } else { "Duplicate values detected" };

    RuleEvaluation {
        rule: format("Uniqueness check on `{}`", rule.col_name),
        expected: exp_str,
        observed: obs_str,
        passed: passed
    }
}

/// Evaluates whether all required schema columns are present in DataFrame.
fn evaluate_column_schema_rule(rule: ColumnSchemaRule, df: DataFrame) -> RuleEvaluation {
    let df_cols = colnames(df);
    let mut missing_count = 0;

    for c in rule.expected_cols {
        let mut found = false;
        for existing in df_cols {
            if existing == c { found = true; }
        }
        if !found { missing_count = missing_count + 1; }
    }

    let passed = missing_count == 0;
    let exp_str = format("All {} columns present", length(rule.expected_cols));
    let obs_str = if passed { "Schema complete" } else { format("{} columns missing", missing_count) };

    RuleEvaluation {
        rule: "Schema Column Integrity",
        expected: exp_str,
        observed: obs_str,
        passed: passed
    }
}
