// spring_pact Demonstration Entry Point (RFC 14)
fn main() {
    println("Welcome to spring_pact: Statistical Contracts and Expectation Protocols!");

    let df = dataframe {
        age: [25.0, 30.0, 42.0, 19.0, 58.0],
        salary: [48000.0, 62000.0, 89000.0, 39000.0, 110000.0]
    };

    let contract = new_contract("Compliance Protocol")
        |> expect_range("age", 18.0, 65.0)
        |> expect_na_max("salary", 0.05)
        |> expect_min_sample_size(5);

    let receipt = verify_contract(contract, df);
    render_cockpit(receipt);
}
