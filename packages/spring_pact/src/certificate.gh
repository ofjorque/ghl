// spring_pact :: Certificate and Cockpit Deck Module (RFC 14)
// Issues cryptographic audit receipts and renders verification panels.

struct RuleEvaluation {
    rule: String,
    expected: String,
    observed: String,
    passed: bool
}

struct AuditReceipt {
    contract_name: String,
    contract_hash: String,
    dataset_hash: String,
    evaluations: Vector,
    is_compliant: bool
}

struct Contract {
    name: String,
    range_rules: Vector,
    na_rules: Vector,
    outlier_rules: Vector,
    vif_rules: Vector,
    sample_rules: Vector,
    vcov_rules: Vector
}

fn new_contract(name: String) -> Contract {
    Contract {
        name: name,
        range_rules: [],
        na_rules: [],
        outlier_rules: [],
        vif_rules: [],
        sample_rules: [],
        vcov_rules: []
    }
}

fn expect_range(contract: Contract, col_name: String, min_val: f64, max_val: f64) -> Contract {
    let rule = create_range_rule(col_name, min_val, max_val);
    Contract {
        name: contract.name,
        range_rules: append(contract.range_rules, rule),
        na_rules: contract.na_rules,
        outlier_rules: contract.outlier_rules,
        vif_rules: contract.vif_rules,
        sample_rules: contract.sample_rules,
        vcov_rules: contract.vcov_rules
    }
}

fn expect_na_max(contract: Contract, col_name: String, threshold: f64) -> Contract {
    let rule = create_na_rule(col_name, threshold);
    Contract {
        name: contract.name,
        range_rules: contract.range_rules,
        na_rules: append(contract.na_rules, rule),
        outlier_rules: contract.outlier_rules,
        vif_rules: contract.vif_rules,
        sample_rules: contract.sample_rules,
        vcov_rules: contract.vcov_rules
    }
}

fn expect_outlier_rule(contract: Contract, col_name: String, method: String, factor: f64) -> Contract {
    let rule = create_outlier_rule(col_name, method, factor);
    Contract {
        name: contract.name,
        range_rules: contract.range_rules,
        na_rules: contract.na_rules,
        outlier_rules: append(contract.outlier_rules, rule),
        vif_rules: contract.vif_rules,
        sample_rules: contract.sample_rules,
        vcov_rules: contract.vcov_rules
    }
}

fn expect_min_sample_size(contract: Contract, min_n: i64) -> Contract {
    let rule = create_min_sample_rule(min_n);
    Contract {
        name: contract.name,
        range_rules: contract.range_rules,
        na_rules: contract.na_rules,
        outlier_rules: contract.outlier_rules,
        vif_rules: contract.vif_rules,
        sample_rules: append(contract.sample_rules, rule),
        vcov_rules: contract.vcov_rules
    }
}

fn expect_vif_max(contract: Contract, max_vif: f64) -> Contract {
    let rule = create_vif_rule(max_vif);
    Contract {
        name: contract.name,
        range_rules: contract.range_rules,
        na_rules: contract.na_rules,
        outlier_rules: contract.outlier_rules,
        vif_rules: append(contract.vif_rules, rule),
        sample_rules: contract.sample_rules,
        vcov_rules: contract.vcov_rules
    }
}

fn expect_vcov_kind(contract: Contract, expected_vcov: String) -> Contract {
    let rule = create_vcov_rule(expected_vcov);
    Contract {
        name: contract.name,
        range_rules: contract.range_rules,
        na_rules: contract.na_rules,
        outlier_rules: contract.outlier_rules,
        vif_rules: contract.vif_rules,
        sample_rules: contract.sample_rules,
        vcov_rules: append(contract.vcov_rules, rule)
    }
}

/// Generates a deterministic SHA-256 hash digest of the agreed contract specifications.
fn contract_digest(contract: Contract) -> String {
    let raw = format("contract:{}:{}:{}:{}:{}:{}",
        contract.name,
        length(contract.range_rules),
        length(contract.na_rules),
        length(contract.outlier_rules),
        length(contract.vif_rules),
        length(contract.sample_rules)
    );
    format("sha256:{}", sha256(raw))
}

/// Verifies all contract rules against a dataset and optional model.
fn verify_contract(contract: Contract, df: DataFrame) -> AuditReceipt {
    let mut evals = [];
    let mut all_passed = true;

    // Evaluate Range Rules
    for r in contract.range_rules {
        let ev = evaluate_range_rule(r, df);
        if !ev.passed {
            all_passed = false;
        }
        evals = append(evals, ev);
    }

    // Evaluate NA Rules
    for r in contract.na_rules {
        let ev = evaluate_na_rule(r, df);
        if !ev.passed {
            all_passed = false;
        }
        evals = append(evals, ev);
    }

    // Evaluate Outlier Rules
    for r in contract.outlier_rules {
        let ev = evaluate_outlier_rule(r, df);
        if !ev.passed {
            all_passed = false;
        }
        evals = append(evals, ev);
    }

    // Evaluate Sample Size Rules
    let n_rows = nrow(df);
    for r in contract.sample_rules {
        let ev = evaluate_min_sample_rule(r, n_rows);
        if !ev.passed {
            all_passed = false;
        }
        evals = append(evals, ev);
    }

    let c_hash = contract_digest(contract);
    let d_hash = format("sha256:{}", sha256(format("dataset:{}:{}", nrow(df), ncol(df))));

    AuditReceipt {
        contract_name: contract.name,
        contract_hash: c_hash,
        dataset_hash: d_hash,
        evaluations: evals,
        is_compliant: all_passed
    }
}

/// Builds the Cockpit Deck receipt panel with Haru/Gojo badge.
fn audit_cockpit(receipt: AuditReceipt) {
    let badge = if receipt.is_compliant {
        "/ᐠ˵- ⩊ -˵マ ✧ CERTIFIED"
    } else {
        "≽(◉˕ ◉ ≼マ VIOLATED"
    };

    let mut p = cockpit("spring_pact Compliance Certificate", badge)
        |> cockpit_add_kv("Contract Name", receipt.contract_name)
        |> cockpit_add_kv("Contract Hash", receipt.contract_hash)
        |> cockpit_add_kv("Dataset Hash", receipt.dataset_hash)
        |> cockpit_add_divider()
        |> cockpit_add_line("Rule                         Expected          Observed       Status");

    for ev in receipt.evaluations {
        let status_str = if ev.passed { "[PASS]" } else { "[FAIL]" };
        let line = format("• {} | exp: {} | obs: {} | {}", ev.rule, ev.expected, ev.observed, status_str);
        p = cockpit_add_line(p, line);
    }

    p = cockpit_add_divider(p);
    if receipt.is_compliant {
        p = cockpit_add_line(p, "/ᐠ˵- ⩊ -˵マ ✧ All statistical pact expectations certified and verified!");
    } else {
        p = cockpit_add_line(p, "≽(◉˕ ◉ ≼マ CONTRACT VIOLATED: Discrepancies detected!");
    }
    p
}

/// Renders the Cockpit Deck receipt panel in terminal with Haru's badge.
fn render_cockpit(receipt: AuditReceipt) {
    let p = audit_cockpit(receipt);
    show_cockpit(p);
}

