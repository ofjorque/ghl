// packages/ghl_panel/tests/panel_test.gh
// Comprehensive integration test suite for ghl_panel econometrics

println("Running ghl_panel comprehensive test suite...");

// =========================================================================
// 1. Synthetic Panel Dataset Generation (N = 6, T = 5)
// =========================================================================
let n_units = 6;
let n_time = 5;
let total_obs = n_units * n_time;
let errors = random_normal(total_obs, 0.0, 0.05, 42);

let mut y_panel = [];
let mut x_panel = [];
let mut unit_ids = [];
let mut time_ids = [];

for i in 0..n_units {
    let fi = 0.0 + i;
    let eta_i = 0.4 * fi; // unit fixed effect
    let mut y_prev = 2.0 + eta_i;

    for t in 0..n_time {
        let ft = 0.0 + t;
        let x_val = 1.0 + (0.5 * ft) + (0.2 * fi);
        let e_val = errors[(i * n_time) + t];
        let y_val = eta_i + (0.5 * y_prev) + (1.2 * x_val) + e_val;

        x_panel = append(x_panel, x_val);
        y_panel = append(y_panel, y_val);
        unit_ids = append(unit_ids, fi);
        time_ids = append(time_ids, ft);
        y_prev = y_val;
    }
}

let df_panel = dataframe {
    y: y_panel,
    x1: x_panel,
    unit: unit_ids,
    time: time_ids
};

// =========================================================================
// 2. Static Panel Econometrics: POLS, Fixed Effects, Random Effects, Hausman
// =========================================================================
println("Testing Static Panel Econometrics (POLS, FE, RE, Hausman, Breusch-Pagan)...");
let static_audit = audit_static_panel(df_panel, "y", ["x1"], "unit");

let pols = static_audit.pooled_ols;
if pols.coefficients[0] <= 0.0 {
    panic("Pooled OLS slope must be positive");
}

let fe = static_audit.fixed_effects;
if fe.n_units != 6 || fe.n_time != 5 {
    panic("Fixed effects dimension mismatch");
}
if fe.r2_within <= 0.0 {
    panic("Fixed effects R^2 within must be positive");
}
if length(fe.unit_effects) != 6 {
    panic("Fixed effects unit count mismatch");
}

let re = static_audit.random_effects;
if re.theta_gls <= 0.0 || re.theta_gls >= 1.0 {
    panic("GLS quasi-demeaning theta must be strictly bounded in (0, 1)");
}

let h = static_audit.hausman;
if h.h_statistic < 0.0 {
    panic("Hausman statistic must be non-negative");
}

let bp = static_audit.breusch_pagan;
if bp.lm_statistic < 0.0 {
    panic("Breusch-Pagan LM statistic must be non-negative");
}

// =========================================================================
// 3. Dynamic Panel: Arellano-Bond Difference GMM (1991)
// =========================================================================
println("Testing Arellano-Bond Difference GMM...");
let diff_gmm = fit_arellano_bond(y_panel, x_panel, n_units, n_time);
render_arellano_bond_cockpit(diff_gmm);

if diff_gmm.n_units != 6 {
    panic("Unit count must be 6");
}
let expected_diff_obs = n_units * (n_time - 2);
if diff_gmm.n_obs != expected_diff_obs {
    panic("Differenced equation count must match N * (T - 2)");
}
if diff_gmm.alpha <= 0.0 {
    panic("Lagged alpha estimate must be positive");
}
if diff_gmm.beta <= 0.0 {
    panic("Exogenous beta estimate must be positive");
}
if diff_gmm.ar2_p < 0.05 {
    panic("AR(2) test must satisfy null of no second-order serial correlation (p >= 0.05)");
}

// =========================================================================
// 4. Dynamic Panel: Blundell-Bond System GMM (1998)
// =========================================================================
println("Testing Blundell-Bond System GMM...");
let sys_gmm = fit_blundell_bond(y_panel, x_panel, n_units, n_time, diff_gmm);
render_blundell_bond_cockpit(sys_gmm);

if !sys_gmm.converged {
    panic("System GMM must converge");
}
let expected_sys_eqs = expected_diff_obs * 2;
if sys_gmm.n_total_equations != expected_sys_eqs {
    panic("System GMM equations must equal diff + level equations");
}
if sys_gmm.alpha <= 0.0 {
    panic("System alpha estimate must be positive");
}
if sys_gmm.beta <= 0.0 {
    panic("System beta estimate must be positive");
}

// =========================================================================
// 5. Cross-Sectional Dependence: Pesaran (2004) CD Test
// =========================================================================
println("Testing Pesaran (2004) CD Test for Cross-Sectional Dependence...");
let cd_res = audit_cross_sectional_dependence(errors, n_units, n_time);
if cd_res.p_value < 0.0 || cd_res.p_value > 1.0 {
    panic("Pesaran CD p-value must be bounded in [0, 1]");
}

// =========================================================================
// 6. Grammar of Graphics Plotting Generators
// =========================================================================
println("Testing Grammar of Graphics Plotting Generators...");
let p_traj = plot_panel_trajectories(df_panel, "unit", "time", "y");
let p_comp = plot_static_comparison(fe, re);

// =========================================================================
// 7. Complete Dynamic Panel Executive Audit
// =========================================================================
println("Testing Complete Dynamic Panel Executive Audit...");
let audit = audit_panel_pipeline(y_panel, x_panel, n_units, n_time);
if !audit.certified {
    panic("Dynamic panel pipeline must certify moment conditions");
}
render_panel_report(audit);

println("All ghl_panel tests passed successfully! /ᐠ˵- ⩊ -˵マ ✧");
