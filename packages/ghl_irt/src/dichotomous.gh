// packages/ghl_irt/src/dichotomous.gh
// Dichotomous IRT Models: 1PL (Rasch), 2PL, and 3PL Calibration via MMLE-EM Algorithm

struct DichotomousIrtResult {
    model_type: String,
    a_params: Vector,
    b_params: Vector,
    c_params: Vector,
    d_params: Vector,
    coefficients: Vector,
    log_likelihood: f64,
    iterations: f64,
    converged: bool,
    n_items: i64,
    n_persons: i64
}

fn prob_4pl(theta: f64, a: f64, b: f64, c: f64, d: f64) -> f64 {
    let z = a * (theta - b);
    let exp_z = if z > 20.0 { exp(20.0) } else { if z < -20.0 { exp(-20.0) } else { exp(z) } };
    let p_logit = exp_z / (1.0 + exp_z);
    c + ((d - c) * p_logit)
}

fn prob_3pl(theta: f64, a: f64, b: f64, c: f64) -> f64 {
    prob_4pl(theta, a, b, c, 1.0)
}

use std::arena::{scope, alloc_vector, reset};

fn fit_dichotomous_irt(
    responses: Vector,
    n_persons: i64,
    n_items: i64,
    model_type: String
) -> DichotomousIrtResult {
    arena::scope(|arena| {
        let quad = get_standard_quadrature();
        let q_nodes = quad.nodes;
        let q_weights = quad.weights;
        let n_q = quad.n_points;

        // Bock-Aitkin Pattern Aggregation:
        // Condense binary examinee vectors into unique response patterns with frequency counts
        let mut pattern_weights = [];
        let mut pattern_responses = [];
        let mut n_patterns = 0;

        if n_items <= 12 {
            let mut pow2 = [];
            let mut curr_pow = 1;
            for j in 0..n_items {
                pow2 = append(pow2, curr_pow);
                curr_pow = curr_pow * 2;
            }
            let total_patterns = curr_pow;
            let mut pattern_counts = arena.alloc_vector(total_patterns, 0.0);

            for i in 0..n_persons {
                let mut code = 0;
                for j in 0..n_items {
                    let resp = responses[(i * n_items) + j];
                    if resp > 0.5 {
                        code = code + pow2[j];
                    }
                }
                pattern_counts = set(pattern_counts, code, pattern_counts[code] + 1.0);
            }

            for k in 0..total_patterns {
                let cnt = pattern_counts[k];
                if cnt > 0.0 {
                    pattern_weights = append(pattern_weights, cnt);
                    n_patterns = n_patterns + 1;
                    for j in 0..n_items {
                        let bit = floor(k / pow2[j]) % 2;
                        pattern_responses = append(pattern_responses, if bit > 0.5 { 1.0 } else { 0.0 });
                    }
                }
            }
        } else {
            n_patterns = n_persons;
            for i in 0..n_persons {
                pattern_weights = append(pattern_weights, 1.0);
            }
            pattern_responses = responses;
        }

        // Precompute Pattern Matrices Y, Y_inv, and Y_t (constant across EM iterations)
        let mut mat_y = zeros(n_patterns, n_items);
        let mut mat_y_inv = zeros(n_patterns, n_items);
        for p in 0..n_patterns {
            let mut row_y = [];
            let mut row_y_inv = [];
            for j in 0..n_items {
                let y_val = pattern_responses[(p * n_items) + j];
                row_y = append(row_y, y_val);
                row_y_inv = append(row_y_inv, 1.0 - y_val);
            }
            mat_y = set_row(mat_y, p, row_y);
            mat_y_inv = set_row(mat_y_inv, p, row_y_inv);
        }
        let mat_y_t = t(mat_y);

        // 1. Initial parameter estimates based on classical item p-values
        let mut a_params = [];
        let mut b_params = [];
        let mut c_params = [];
        let mut d_params = [];

        for j in 0..n_items {
            let mut sum_correct = 0.0;
            for p in 0..n_patterns {
                let resp = pattern_responses[(p * n_items) + j];
                if resp > 0.5 {
                    sum_correct = sum_correct + pattern_weights[p];
                }
            }
            let p_val = (sum_correct + 0.5) / ((0.0 + n_persons) + 1.0);
            let logit_p = ln(p_val / (1.0 - p_val));
            let init_b = 0.0 - logit_p;

            let init_a = 1.0;
            let init_c = if model_type == "3PL" || model_type == "4PL" { 0.20 } else { 0.0 };
            let init_d = if model_type == "4PL" { 0.96 } else { 1.00 };

            a_params = append(a_params, init_a);
            b_params = append(b_params, init_b);
            c_params = append(c_params, init_c);
            d_params = append(d_params, init_d);
        }

        let max_iter = 40;
        let tol = 0.015;
        let mut converged = false;
        let mut iter_count = 0.0;
        let mut final_loglik = 0.0;

        let mut b_prev_1 = [];
        let mut b_prev_2 = [];
        let mut a_prev_1 = [];
        let mut a_prev_2 = [];

        let mut iter = 0;
        while !converged && iter < max_iter {
            iter = iter + 1;
            iter_count = iter_count + 1.0;

            b_prev_2 = b_prev_1;
            b_prev_1 = b_params;
            a_prev_2 = a_prev_1;
            a_prev_1 = a_params;

            // --- E-STEP: Vectorized GEMM formulation backed by faer ---
            let mut log_p_mat = zeros(n_items, n_q);
            let mut log_q_mat = zeros(n_items, n_q);
            for j in 0..n_items {
                let a_j = a_params[j];
                let b_j = b_params[j];
                let c_j = c_params[j];
                let d_j = d_params[j];
                let mut row_lp = [];
                let mut row_lq = [];
                for q in 0..n_q {
                    let theta_q = q_nodes[q];
                    let z = a_j * (theta_q - b_j);
                    let exp_z = if z > 20.0 { exp(20.0) } else { if z < -20.0 { exp(-20.0) } else { exp(z) } };
                    let p_logit = exp_z / (1.0 + exp_z);
                    let p_jq = c_j + ((d_j - c_j) * p_logit);
                    let safe_p = if p_jq < 0.0001 { 0.0001 } else { if p_jq > 0.9999 { 0.9999 } else { p_jq } };
                    row_lp = append(row_lp, ln(safe_p));
                    row_lq = append(row_lq, ln(1.0 - safe_p));
                }
                log_p_mat = set_row(log_p_mat, j, row_lp);
                log_q_mat = set_row(log_q_mat, j, row_lq);
            }

            // Two GEMM multiplications in faer to get conditional log-likelihood matrix (P x Q) in microseconds
            let log_l_mat = (mat_y * log_p_mat) .+ (mat_y_inv * log_q_mat);

            // Compute posterior pattern distribution and build w_post_mat (P x Q)
            let mut w_post_mat = zeros(n_patterns, n_q);
            let mut current_loglik = 0.0;

            for p in 0..n_patterns {
                let log_row = get_row(log_l_mat, p);
                let mut max_log_p = -1.0e10;
                for q in 0..n_q {
                    let val = log_row[q];
                    if val > max_log_p {
                        max_log_p = val;
                    }
                }

                let mut unnorm_row = [];
                let mut sum_post = 0.0;
                for q in 0..n_q {
                    let unnorm = exp(log_row[q] - max_log_p) * q_weights[q];
                    unnorm_row = append(unnorm_row, unnorm);
                    sum_post = sum_post + unnorm;
                }

                let p_p_marginal = sum_post * exp(max_log_p);
                let pw = pattern_weights[p];
                if p_p_marginal > 0.0000000001 {
                    current_loglik = current_loglik + (pw * ln(p_p_marginal));
                }

                let inv_sum = if sum_post > 0.0 { 1.0 / sum_post } else { 0.0 };
                let mut w_post_row = [];
                for q in 0..n_q {
                    let post_q = unnorm_row[q] * inv_sum;
                    w_post_row = append(w_post_row, pw * post_q);
                }
                w_post_mat = set_row(w_post_mat, p, w_post_row);
            }

            final_loglik = current_loglik;

            // Accumulate expected test-takers n_q from posterior column sums
            let mut n_table = [];
            for q in 0..n_q {
                let mut sum_nq = 0.0;
                for p in 0..n_patterns {
                    sum_nq = sum_nq + w_post_mat[p, q];
                }
                n_table = append(n_table, sum_nq);
            }

            // GEMM product to compute r_table (J x Q) in ONE step: R = Y^T * W_Post
            let r_mat = mat_y_t * w_post_mat;

            // --- M-STEP: Update item parameters based on expected counts r_{jq} and n_q ---
            let mut max_param_change = 0.0;

            for j in 0..n_items {
                let old_a = a_params[j];
                let old_b = b_params[j];
                let old_c = c_params[j];
                let old_d = d_params[j];

                let mut grad_b = 0.0;
                let mut info_b = 0.0;
                let mut grad_a = 0.0;
                let mut info_a = 0.0;

                for q in 0..n_q {
                    let theta_q = q_nodes[q];
                    let z = old_a * (theta_q - old_b);
                    let exp_z = if z > 20.0 { exp(20.0) } else { if z < -20.0 { exp(-20.0) } else { exp(z) } };
                    let p_logit = exp_z / (1.0 + exp_z);
                    let p_jq = old_c + ((old_d - old_c) * p_logit);
                    let safe_p = if p_jq < 0.0001 { 0.0001 } else { if p_jq > 0.9999 { 0.9999 } else { p_jq } };

                    let n_q_val = n_table[q];
                    let r_jq_val = r_mat[j, q];
                    let exp_diff = r_jq_val - (n_q_val * safe_p);

                    // Logistic derivative components
                    let w_factor = if old_d > old_c { (safe_p - old_c) / (old_d - old_c) } else { 1.0 };
                    let dp_db = 0.0 - (old_a * w_factor * (1.0 - p_logit) * (old_d - old_c));
                    let dp_da = (theta_q - old_b) * w_factor * (1.0 - p_logit) * (old_d - old_c);

                    let var_inv = 1.0 / (safe_p * (1.0 - safe_p));

                    grad_b = grad_b + (exp_diff * var_inv * dp_db);
                    info_b = info_b + (n_q_val * var_inv * dp_db * dp_db);

                    grad_a = grad_a + (exp_diff * var_inv * dp_da);
                    info_a = info_a + (n_q_val * var_inv * dp_da * dp_da);
                }

                // Update difficulty b_j
                let raw_step_b = if info_b > 0.0000000001 { grad_b / info_b } else { 0.0 };
                let clip_step_b = if raw_step_b > 0.40 { 0.40 } else { if raw_step_b < -0.40 { -0.40 } else { raw_step_b } };
                let step_b = clip_step_b * 0.75;
                let mut new_b = old_b + step_b;
                if new_b < -3.5 { new_b = -3.5; }
                if new_b > 3.5 { new_b = 3.5; }

                // Update discrimination a_j (if 2PL, 3PL or 4PL)
                let mut new_a = old_a;
                if model_type != "1PL" {
                    let raw_step_a = if info_a > 0.0000000001 { grad_a / info_a } else { 0.0 };
                    let clip_step_a = if raw_step_a > 0.35 { 0.35 } else { if raw_step_a < -0.35 { -0.35 } else { raw_step_a } };
                    let step_a = clip_step_a * 0.75;
                    new_a = old_a + step_a;
                    if new_a < 0.20 { new_a = 0.20; }
                    if new_a > 3.00 { new_a = 3.00; }
                }

                let change_b = abs(new_b - old_b);
                let change_a = abs(new_a - old_a);
                let change_j = if change_b > change_a { change_b } else { change_a };
                if change_j > max_param_change {
                    max_param_change = change_j;
                }

                a_params = set(a_params, j, new_a);
                b_params = set(b_params, j, new_b);
            }

            // --- AITKEN ACCELERATION STEP (every 3 iterations when monotonic) ---
            if iter >= 3 && ((iter % 3) == 0) {
                for j in 0..n_items {
                    let b0 = b_prev_2[j];
                    let b1 = b_prev_1[j];
                    let b2 = b_params[j];
                    let d1_b = b1 - b0;
                    let d2_b = b2 - b1;
                    let d2_diff_b = d2_b - d1_b;
                    if (d1_b * d2_b) > 0.0 && abs(d2_diff_b) > 0.0001 {
                        let accel_step_b = (d2_b * d2_b) / d2_diff_b;
                        if abs(accel_step_b) < 0.50 {
                            let mut accel_b = b2 - accel_step_b;
                            if accel_b < -3.5 { accel_b = -3.5; }
                            if accel_b > 3.5 { accel_b = 3.5; }
                            b_params = set(b_params, j, accel_b);
                        }
                    }

                    if model_type != "1PL" {
                        let a0 = a_prev_2[j];
                        let a1 = a_prev_1[j];
                        let a2 = a_params[j];
                        let d1_a = a1 - a0;
                        let d2_a = a2 - a1;
                        let d2_diff_a = d2_a - d1_a;
                        if (d1_a * d2_a) > 0.0 && abs(d2_diff_a) > 0.0001 {
                            let accel_step_a = (d2_a * d2_a) / d2_diff_a;
                            if abs(accel_step_a) < 0.40 {
                                let mut accel_a = a2 - accel_step_a;
                                if accel_a < 0.20 { accel_a = 0.20; }
                                if accel_a > 3.00 { accel_a = 3.00; }
                                a_params = set(a_params, j, accel_a);
                            }
                        }
                    }
                }
            }

            arena.reset();

            if max_param_change < tol {
                converged = true;
            }
        }

        DichotomousIrtResult {
        model_type: model_type,
        a_params: a_params,
        b_params: b_params,
        c_params: c_params,
        d_params: d_params,
        coefficients: b_params,
        log_likelihood: final_loglik,
        iterations: iter_count,
        converged: converged,
        n_items: n_items,
        n_persons: n_persons
    }
    })
}

fn fit_1pl(responses: Vector, n_persons: i64, n_items: i64) -> DichotomousIrtResult {
    fit_dichotomous_irt(responses, n_persons, n_items, "1PL")
}

fn fit_2pl(responses: Vector, n_persons: i64, n_items: i64) -> DichotomousIrtResult {
    fit_dichotomous_irt(responses, n_persons, n_items, "2PL")
}

fn fit_3pl(responses: Vector, n_persons: i64, n_items: i64) -> DichotomousIrtResult {
    fit_dichotomous_irt(responses, n_persons, n_items, "3PL")
}

fn fit_4pl(responses: Vector, n_persons: i64, n_items: i64) -> DichotomousIrtResult {
    fit_dichotomous_irt(responses, n_persons, n_items, "4PL")
}

fn coef_irt(result: DichotomousIrtResult) -> DataFrame {
    let mut item_indices = [];
    for j in 0..result.n_items {
        item_indices = append(item_indices, 1 + j);
    }
    dataframe {
        item: item_indices,
        a: result.a_params,
        b: result.b_params,
        c: result.c_params,
        d: result.d_params
    }
}
