// packages/ghl_irt/src/quadrature.gh
// Gauss-Hermite Quadrature Grid & Standard Normal Prior Weights for Latent Trait Integration

struct QuadratureGrid {
    nodes: Vector,
    weights: Vector,
    n_points: i64
}

fn get_standard_quadrature() -> QuadratureGrid {
    // 15-point symmetric quadrature grid spanning [-3.5, +3.5]
    let nodes = [
        -3.50, -3.00, -2.50, -2.00, -1.50, -1.00, -0.50,
         0.00,
         0.50,  1.00,  1.50,  2.00,  2.50,  3.00,  3.50
    ];

    let mut weights = [];
    let mut sum_w = 0.0;

    // Normal probability density: phi(theta) = exp(-0.5 * theta^2) / sqrt(2 * pi)
    let inv_sqrt_2pi = 0.3989422804014327;
    for q in nodes {
        let w = inv_sqrt_2pi * exp(-0.5 * (q * q));
        weights = append(weights, w);
        sum_w = sum_w + w;
    }

    // Normalize weights to sum strictly to 1.0
    let mut norm_weights = [];
    for w in weights {
        norm_weights = append(norm_weights, w / sum_w);
    }

    QuadratureGrid {
        nodes: nodes,
        weights: norm_weights,
        n_points: 15
    }
}

struct MultidimensionalGrid {
    nodes: Matrix,
    weights: Vector,
    n_points: i64,
    n_dimensions: i64
}

fn get_multidimensional_quadrature(n_dimensions: i64, points_per_dim: i64) -> MultidimensionalGrid {
    let grid = irt_quadrature_grid(n_dimensions, points_per_dim, 3.5);
    MultidimensionalGrid {
        nodes: grid.nodes,
        weights: grid.weights,
        n_points: grid.n_points,
        n_dimensions: grid.n_dimensions
    }
}

