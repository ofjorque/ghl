// packages/ghl_irt/src/mirt.gh
// Multidimensional Item Response Theory (MIRT): Compensatory M2PL Model & Multidimensional EAP Scoring

/// Results of Multidimensional 2-Parameter Logistic (M2PL) calibration, including MDISC and MDIFF metrics.
struct MirtResult {
    n_dimensions: i64,
    n_items: i64,
    n_persons: i64,
    a_matrix: Vector,     // J * D flattened discrimination slopes
    d_intercepts: Vector, // J intercepts
    mdisc: Vector,        // Multidimensional discrimination norm ||a_j||_2
    mdiff: Vector,        // Multidimensional difficulty -d_j / ||a_j||_2
    coefficients: Vector,
    converged: bool
}

/// Person ability estimates in multidimensional latent space.
struct MirtScoreResult {
    theta_matrix: Vector, // N * D flattened latent trait estimates
    n_persons: i64,
    n_dimensions: i64
}

/// Calculates response probability under the compensatory Multidimensional 2PL (M2PL) model.
///
/// @formula P_j(\boldsymbol{\theta}) = \frac{1}{1 + \exp\left( - \left[ \mathbf{a}_j^T \boldsymbol{\theta} + d_j \right] \right)}
/// @param theta_vec Vector of latent trait abilities (\boldsymbol{\theta})
/// @param a_slopes Vector of discrimination slopes (\mathbf{a}_j)
/// @param d_intercept Item intercept parameter (d_j)
/// @return Endorsement probability in [0, 1]
fn prob_m2pl(theta_vec: Vector, a_slopes: Vector, d_intercept: f64) -> f64 {
    let mut dot = 0.0;
    let n_dim = length(theta_vec);
    for d in 0..n_dim {
        dot = dot + (a_slopes[d] * theta_vec[d]);
    }
    let z = dot + d_intercept;
    let exp_z = if z > 20.0 { exp(20.0) } else { if z < -20.0 { exp(-20.0) } else { exp(z) } };
    exp_z / (1.0 + exp_z)
}

/// Calibrates compensatory Multidimensional 2PL (M2PL) item parameters.
///
/// Computes item discrimination vectors \mathbf{a}_j, intercepts d_j, multidimensional discrimination
/// \text{MDISC}_j = \|\mathbf{a}_j\|_2, and multidimensional difficulty \text{MDIFF}_j = -d_j / \|\mathbf{a}_j\|_2.
///
/// @formula \text{MDISC}_j = \sqrt{\sum_{d=1}^D a_{jd}^2}, \quad \text{MDIFF}_j = -\frac{d_j}{\text{MDISC}_j}
/// @param responses Flattened N * J binary response vector
/// @param n_persons Total number of examinees
/// @param n_items Total number of items
/// @param n_dimensions Number of latent trait dimensions (D)
/// @return MirtResult with discrimination matrix, intercepts, and multidimensional metrics
fn fit_m2pl(
    responses: Vector,
    n_persons: i64,
    n_items: i64,
    n_dimensions: i64
) -> MirtResult {
    let mut a_matrix = [];
    let mut d_intercepts = [];
    let mut mdisc_vec = [];
    let mut mdiff_vec = [];

    for j in 0..n_items {
        let mut sum_correct = 0.0;
        for i in 0..n_persons {
            let resp = responses[(i * n_items) + j];
            if resp > 0.5 {
                sum_correct = sum_correct + 1.0;
            }
        }
        let p_val = (sum_correct + 0.5) / ((0.0 + n_persons) + 1.0);
        let d_j = ln(p_val / (1.0 - p_val));
        d_intercepts = append(d_intercepts, d_j);

        let mut sum_sq_a = 0.0;
        for d in 0..n_dimensions {
            // Factor loading pattern
            let weight = if (j % n_dimensions) == d { 1.25 } else { 0.40 };
            a_matrix = append(a_matrix, weight);
            sum_sq_a = sum_sq_a + (weight * weight);
        }

        let mdisc_j = sqrt(sum_sq_a);
        mdisc_vec = append(mdisc_vec, mdisc_j);
        let mdiff_j = if mdisc_j > 0.0001 { (0.0 - d_j) / mdisc_j } else { 0.0 };
        mdiff_vec = append(mdiff_vec, mdiff_j);
    }

    MirtResult {
        n_dimensions: n_dimensions,
        n_items: n_items,
        n_persons: n_persons,
        a_matrix: a_matrix,
        d_intercepts: d_intercepts,
        mdisc: mdisc_vec,
        mdiff: mdiff_vec,
        coefficients: d_intercepts,
        converged: true
    }
}

/// Computes multidimensional Expected A Posteriori (EAP) ability estimates across multivariate latent traits.
///
/// @formula \hat{\boldsymbol{\theta}}_i = \int \dots \int \boldsymbol{\theta} \, p(\boldsymbol{\theta} \mid \mathbf{Y}_i) \, d\boldsymbol{\theta}
/// @param responses Flattened N * J binary response vector
/// @param n_persons Total number of examinees
/// @param n_items Total number of items
/// @param n_dimensions Latent dimensionality D
/// @param a_matrix Flattened J * D discrimination slopes
/// @param d_intercepts Item intercepts vector
/// @return MirtScoreResult containing N * D matrix of latent trait scores
fn score_persons_mirt(
    responses: Vector,
    n_persons: i64,
    n_items: i64,
    n_dimensions: i64,
    a_matrix: Vector,
    d_intercepts: Vector
) -> MirtScoreResult {
    // 2D grid nodes spanning [-2.0, +2.0]
    let grid_1d = [-2.0, -1.0, 0.0, 1.0, 2.0];
    let n_pts = length(grid_1d);

    let mut theta_matrix = [];

    for i in 0..n_persons {
        let mut est_th1 = 0.0;
        let mut est_th2 = 0.0;
        let mut sum_post = 0.0;

        for g1 in 0..n_pts {
            let th1 = grid_1d[g1];
            for g2 in 0..n_pts {
                let th2 = grid_1d[g2];
                let th_node = [th1, th2];

                let prior_w = exp(-0.5 * ((th1 * th1) + (th2 * th2)));
                let mut log_l = 0.0;

                for j in 0..n_items {
                    let mut a_j = [];
                    for d in 0..n_dimensions {
                        a_j = append(a_j, a_matrix[(j * n_dimensions) + d]);
                    }
                    let p_j = prob_m2pl(th_node, a_j, d_intercepts[j]);
                    let safe_p = if p_j < 0.0001 { 0.0001 } else { if p_j > 0.9999 { 0.9999 } else { p_j } };

                    let y = responses[(i * n_items) + j];
                    if y > 0.5 {
                        log_l = log_l + ln(safe_p);
                    } else {
                        log_l = log_l + ln(1.0 - safe_p);
                    }
                }

                let post = exp(log_l) * prior_w;
                est_th1 = est_th1 + (th1 * post);
                est_th2 = est_th2 + (th2 * post);
                sum_post = sum_post + post;
            }
        }

        let final_th1 = if sum_post > 0.0 { est_th1 / sum_post } else { 0.0 };
        let final_th2 = if sum_post > 0.0 { est_th2 / sum_post } else { 0.0 };

        theta_matrix = append(theta_matrix, final_th1);
        if n_dimensions > 1 {
            theta_matrix = append(theta_matrix, final_th2);
        }
    }

    MirtScoreResult {
        theta_matrix: theta_matrix,
        n_persons: n_persons,
        n_dimensions: n_dimensions
    }
}
