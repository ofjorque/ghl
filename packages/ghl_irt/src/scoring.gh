// packages/ghl_irt/src/scoring.gh
// Robust Person Ability Scoring via Expected A Posteriori (EAP) Integration

/// Ability score estimates, posterior standard errors, and empirical reliability.
struct PersonScoreResult {
    thetas: Vector,
    standard_errors: Vector,
    mean_theta: f64,
    var_theta: f64,
    reliability: f64
}

/// Computes Expected A Posteriori (EAP) latent ability estimates and posterior standard errors for dichotomous items.
///
/// Integrates over the standard normal prior \phi(\theta) \sim \mathcal{N}(0, 1) using Gauss-Hermite quadrature.
/// Also calculates empirical reliability \rho_{xx} = \frac{\text{Var}(\hat{\theta})}{\text{Var}(\hat{\theta}) + \overline{\text{SE}^2}}.
///
/// @formula \hat{\theta}_i^{\text{EAP}} = \int_{-\infty}^\infty \theta \, p(\theta \mid \mathbf{Y}_i) \, d\theta, \quad \text{SE}(\hat{\theta}_i) = \sqrt{\text{Var}(\theta \mid \mathbf{Y}_i)}
/// @param responses Flattened N * J binary response vector
/// @param n_persons Total number of examinees
/// @param n_items Total number of items
/// @param a_params Calibrated item discriminations
/// @param b_params Calibrated item difficulties
/// @param c_params Calibrated item guessing parameters
/// @return PersonScoreResult containing ability estimates (\hat{\theta}), standard errors, and scale reliability
fn score_persons_dichotomous(
    responses: Vector,
    n_persons: i64,
    n_items: i64,
    a_params: Vector,
    b_params: Vector,
    c_params: Vector
) -> PersonScoreResult {
    let quad = get_standard_quadrature();
    let q_nodes = quad.nodes;
    let q_weights = quad.weights;
    let n_q = quad.n_points;

    let mut thetas = [];
    let mut ses = [];
    let mut sum_th = 0.0;
    let mut sum_se2 = 0.0;

    for i in 0..n_persons {
        let mut log_p_node = [];
        let mut max_log_p = -1.0e10;

        for q in 0..n_q {
            let theta_q = q_nodes[q];
            let mut log_l = 0.0;

            for j in 0..n_items {
                let a_j = a_params[j];
                let b_j = b_params[j];
                let c_j = c_params[j];
                let p_jq = prob_3pl(theta_q, a_j, b_j, c_j);
                let safe_p = if p_jq < 0.0001 { 0.0001 } else { if p_jq > 0.9999 { 0.9999 } else { p_jq } };

                let y_ij = responses[(i * n_items) + j];
                if y_ij > 0.5 {
                    log_l = log_l + ln(safe_p);
                } else {
                    log_l = log_l + ln(1.0 - safe_p);
                }
            }

            log_p_node = append(log_p_node, log_l);
            if log_l > max_log_p {
                max_log_p = log_l;
            }
        }

        let mut post_weights = [];
        let mut sum_post = 0.0;
        for q in 0..n_q {
            let unnorm = exp(log_p_node[q] - max_log_p) * q_weights[q];
            post_weights = append(post_weights, unnorm);
            sum_post = sum_post + unnorm;
        }

        // Expected A Posteriori: mean and standard deviation of posterior
        let mut eap_theta = 0.0;
        for q in 0..n_q {
            let prob_q = post_weights[q] / sum_post;
            eap_theta = eap_theta + (q_nodes[q] * prob_q);
        }

        let mut eap_var = 0.0;
        for q in 0..n_q {
            let prob_q = post_weights[q] / sum_post;
            let diff = q_nodes[q] - eap_theta;
            eap_var = eap_var + (diff * diff * prob_q);
        }
        let eap_se = sqrt(eap_var);

        thetas = append(thetas, eap_theta);
        ses = append(ses, eap_se);
        sum_th = sum_th + eap_theta;
        sum_se2 = sum_se2 + eap_var;
    }

    let fn_p = 0.0 + n_persons;
    let mean_th = sum_th / fn_p;

    let mut sum_var = 0.0;
    for th in thetas {
        let diff = th - mean_th;
        sum_var = sum_var + (diff * diff);
    }
    let var_th = if fn_p > 1.0 { sum_var / (fn_p - 1.0) } else { 0.0 };
    let mean_err_var = sum_se2 / fn_p;

    // Empirical EAP Reliability: Var(theta) / (Var(theta) + Mean(SE^2))
    let total_v = var_th + mean_err_var;
    let rel = if total_v > 0.0 { var_th / total_v } else { 0.0 };

    PersonScoreResult {
        thetas: thetas,
        standard_errors: ses,
        mean_theta: mean_th,
        var_theta: var_th,
        reliability: rel
    }
}

/// Computes Expected A Posteriori (EAP) ability estimates and standard errors for Samejima's Graded Response Model (GRM).
///
/// @formula \hat{\theta}_i = \int_{-\infty}^\infty \theta \prod_{j=1}^J P_{j,y_{ij}}(\theta) \phi(\theta) d\theta
/// @param responses Flattened N * J polytomous response vector (0 to K-1)
/// @param n_persons Total number of examinees
/// @param n_items Total number of items
/// @param n_categories Number of score categories K
/// @param a_params Item discrimination slopes
/// @param thresholds Flattened category boundary thresholds
/// @return PersonScoreResult containing ability estimates (\hat{\theta}) and empirical reliability
fn score_persons_graded(
    responses: Vector,
    n_persons: i64,
    n_items: i64,
    n_categories: i64,
    a_params: Vector,
    thresholds: Vector
) -> PersonScoreResult {
    let quad = get_standard_quadrature();
    let q_nodes = quad.nodes;
    let q_weights = quad.weights;
    let n_q = quad.n_points;

    let mut thetas = [];
    let mut ses = [];
    let mut sum_th = 0.0;
    let mut sum_se2 = 0.0;

    for i in 0..n_persons {
        let mut log_p_node = [];
        let mut max_log_p = -1.0e10;

        for q in 0..n_q {
            let theta_q = q_nodes[q];
            let mut log_l = 0.0;

            for j in 0..n_items {
                let a_j = a_params[j];
                let y_ij = responses[(i * n_items) + j];
                let k_val = to_int(y_ij);
                let p_cat = grm_category_prob(theta_q, a_j, thresholds, j, n_categories, k_val);
                log_l = log_l + ln(p_cat);
            }

            log_p_node = append(log_p_node, log_l);
            if log_l > max_log_p {
                max_log_p = log_l;
            }
        }

        let mut post_weights = [];
        let mut sum_post = 0.0;
        for q in 0..n_q {
            let unnorm = exp(log_p_node[q] - max_log_p) * q_weights[q];
            post_weights = append(post_weights, unnorm);
            sum_post = sum_post + unnorm;
        }

        let mut eap_theta = 0.0;
        for q in 0..n_q {
            let prob_q = post_weights[q] / sum_post;
            eap_theta = eap_theta + (q_nodes[q] * prob_q);
        }

        let mut eap_var = 0.0;
        for q in 0..n_q {
            let prob_q = post_weights[q] / sum_post;
            let diff = q_nodes[q] - eap_theta;
            eap_var = eap_var + (diff * diff * prob_q);
        }
        let eap_se = sqrt(eap_var);

        thetas = append(thetas, eap_theta);
        ses = append(ses, eap_se);
        sum_th = sum_th + eap_theta;
        sum_se2 = sum_se2 + eap_var;
    }

    let fn_p = 0.0 + n_persons;
    let mean_th = sum_th / fn_p;

    let mut sum_var = 0.0;
    for th in thetas {
        let diff = th - mean_th;
        sum_var = sum_var + (diff * diff);
    }
    let var_th = if fn_p > 1.0 { sum_var / (fn_p - 1.0) } else { 0.0 };
    let mean_err_var = sum_se2 / fn_p;
    let total_v = var_th + mean_err_var;
    let rel = if total_v > 0.0 { var_th / total_v } else { 0.0 };

    PersonScoreResult {
        thetas: thetas,
        standard_errors: ses,
        mean_theta: mean_th,
        var_theta: var_th,
        reliability: rel
    }
}

// =========================================================================
// 3. Person Fit Diagnostics: Drasgow's Standardized Statistic (Zh, 1985)
// =========================================================================

/// Person-fit diagnostics containing standardized log-likelihood z_h statistics and aberrant response flags.
struct PersonFitResult {
    zh_scores: Vector,
    aberrant_flags: Vector,
    mean_zh: f64,
    n_aberrant: i64
}

/// Computes Drasgow, Levine & Williams (1985) standardized person-fit statistic (z_h).
///
/// Detects aberrant response behavior such as random guessing, cheating, or inattention.
/// Under appropriate fit, z_h follows an approximate standard normal \mathcal{N}(0, 1) distribution;
/// examinees with z_h < -2.0 are flagged as aberrant.
///
/// @formula z_h = \frac{l_0 - \mathbb{E}[l_0]}{\sqrt{\text{Var}(l_0)}}
/// @param responses Flattened N * J binary response vector
/// @param n_persons Total number of examinees
/// @param n_items Total number of items
/// @param a_params Calibrated item discriminations
/// @param b_params Calibrated item difficulties
/// @param c_params Calibrated item guessing parameters
/// @param thetas Estimated person ability scores (\theta)
/// @return PersonFitResult containing z_h vectors, aberrant examinee flags, and aberration counts
fn compute_person_fit_zh(
    responses: Vector,
    n_persons: i64,
    n_items: i64,
    a_params: Vector,
    b_params: Vector,
    c_params: Vector,
    thetas: Vector
) -> PersonFitResult {
    let mut zh_scores = [];
    let mut flags = [];
    let mut n_flagged = 0;
    let mut sum_zh = 0.0;

    for i in 0..n_persons {
        let th = thetas[i];
        let mut l0 = 0.0;
        let mut e_l0 = 0.0;
        let mut var_l0 = 0.0;

        for j in 0..n_items {
            let a_j = a_params[j];
            let b_j = b_params[j];
            let c_j = c_params[j];
            let p_j = prob_3pl(th, a_j, b_j, c_j);
            let safe_p = if p_j < 0.0001 { 0.0001 } else { if p_j > 0.9999 { 0.9999 } else { p_j } };
            let q_j = 1.0 - safe_p;

            let y_ij = responses[(i * n_items) + j];
            let ln_p = ln(safe_p);
            let ln_q = ln(q_j);

            let l_ij = (y_ij * ln_p) + ((1.0 - y_ij) * ln_q);
            l0 = l0 + l_ij;

            let e_ij = (safe_p * ln_p) + (q_j * ln_q);
            e_l0 = e_l0 + e_ij;

            let log_ratio = ln(safe_p / q_j);
            var_l0 = var_l0 + (safe_p * q_j * log_ratio * log_ratio);
        }

        let zh = if var_l0 > 0.00001 {
            (l0 - e_l0) / sqrt(var_l0)
        } else {
            0.0
        };

        zh_scores = append(zh_scores, zh);
        sum_zh = sum_zh + zh;

        let is_aberrant = zh < -2.0;
        flags = append(flags, is_aberrant);
        if is_aberrant {
            n_flagged = n_flagged + 1;
        }
    }

    let fn_p = 0.0 + n_persons;
    PersonFitResult {
        zh_scores: zh_scores,
        aberrant_flags: flags,
        mean_zh: sum_zh / fn_p,
        n_aberrant: n_flagged
    }
}
