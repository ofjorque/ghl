// packages/ghl_irt/src/dif.gh
// Differential Item Functioning (DIF) Analysis: Mantel-Haenszel & Lord's Wald Test

/// DIF metrics and Educational Testing Service (ETS) classification for an item.
struct DifItemResult {
    item_index: i64,
    alpha_mh: f64,
    delta_mh: f64,
    ets_classification: String, // "A (Negligible)", "B (Moderate)", "C (Severe)"
    wald_stat: f64,
    is_flagged: bool
}

/// Overall DIF analysis summary across all test items.
struct DifAnalysisResult {
    items: Vector, // Vector of DifItemResult or DataFrame
    n_flagged_moderate: i64,
    n_flagged_severe: i64,
    reference_count: i64,
    focal_count: i64
}

/// Evaluates Differential Item Functioning using the Mantel-Haenszel odds-ratio method and ETS classification.
///
/// Matches examinees on ability strata and computes the common odds ratio \alpha_{\text{MH}} and the ETS
/// effect size metric \Delta_{\text{MH}} = -2.35 \ln(\alpha_{\text{MH}}). Categorizes items into ETS Class A (negligible),
/// Class B (moderate), or Class C (severe DIF).
///
/// @formula \alpha_{\text{MH}} = \frac{\sum_m A_m D_m / T_m}{\sum_m B_m C_m / T_m}, \quad \Delta_{\text{MH}} = -2.35 \ln(\alpha_{\text{MH}})
/// @param responses Flattened N * J binary response vector
/// @param group_membership Group indicator vector (0 = Reference, 1 = Focal)
/// @param n_persons Total number of examinees
/// @param n_items Total number of items
/// @param thetas Ability matching scores (\theta)
/// @return DifAnalysisResult with item-level odds ratios, ETS classifications, and flagged counts
fn compute_mantel_haenszel_dif(
    responses: Vector,
    group_membership: Vector, // 0 for Reference group, 1 for Focal group
    n_persons: i64,
    n_items: i64,
    thetas: Vector
) -> DifAnalysisResult {
    let mut ref_count = 0;
    let mut foc_count = 0;
    for g in group_membership {
        if g > 0.5 {
            foc_count = foc_count + 1;
        } else {
            ref_count = ref_count + 1;
        }
    }

    // Number of ability matching strata
    let n_strata = 5;
    let min_th = -2.5;
    let max_th = 2.5;
    let step_th = (max_th - min_th) / (0.0 + n_strata);

    let mut dif_items = [];
    let mut n_mod = 0;
    let mut n_sev = 0;

    for j in 0..n_items {
        let mut sum_num = 0.0;
        let mut sum_den = 0.0;

        for s in 0..n_strata {
            let s_lo = min_th + ((0.0 + s) * step_th);
            let s_hi = s_lo + step_th;

            let mut a_m = 0.0; // Reference Correct
            let mut b_m = 0.0; // Reference Incorrect
            let mut c_m = 0.0; // Focal Correct
            let mut d_m = 0.0; // Focal Incorrect

            for i in 0..n_persons {
                let th = thetas[i];
                let in_stratum = if s == (n_strata - 1) {
                    th >= s_lo && th <= (s_hi + 1.0)
                } else {
                    th >= s_lo && th < s_hi
                };

                if in_stratum {
                    let g = group_membership[i];
                    let y = responses[(i * n_items) + j];
                    if g < 0.5 {
                        // Reference
                        if y > 0.5 { a_m = a_m + 1.0; } else { b_m = b_m + 1.0; }
                    } else {
                        // Focal
                        if y > 0.5 { c_m = c_m + 1.0; } else { d_m = d_m + 1.0; }
                    }
                }
            }

            let t_m = a_m + b_m + c_m + d_m;
            if t_m > 0.0 {
                sum_num = sum_num + ((a_m * d_m) / t_m);
                sum_den = sum_den + ((b_m * c_m) / t_m);
            }
        }

        // Common Odds Ratio alpha_MH
        let alpha = if sum_den > 0.0001 {
            sum_num / sum_den
        } else {
            1.0
        };
        let safe_alpha = if alpha < 0.05 { 0.05 } else { if alpha > 20.0 { 20.0 } else { alpha } };

        // ETS Delta Metric: Delta_MH = -2.35 * ln(alpha_MH)
        let delta = 0.0 - (2.35 * ln(safe_alpha));
        let abs_delta = abs(delta);

        let mut ets_class = "A (Negligible)";
        let mut flagged = false;

        if abs_delta >= 1.5 {
            ets_class = "C (Severe)";
            flagged = true;
            n_sev = n_sev + 1;
        } else if abs_delta >= 1.0 {
            ets_class = "B (Moderate)";
            flagged = true;
            n_mod = n_mod + 1;
        }

        let wald = delta * delta;

        let item_res = DifItemResult {
            item_index: 1 + j,
            alpha_mh: safe_alpha,
            delta_mh: delta,
            ets_classification: ets_class,
            wald_stat: wald,
            is_flagged: flagged
        };
        dif_items = append(dif_items, item_res);
    }

    DifAnalysisResult {
        items: dif_items,
        n_flagged_moderate: n_mod,
        n_flagged_severe: n_sev,
        reference_count: ref_count,
        focal_count: foc_count
    }
}
