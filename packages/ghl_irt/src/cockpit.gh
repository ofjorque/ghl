// packages/ghl_irt/src/cockpit.gh
// Visual Cockpit Deck Panels for IRT Item Calibration, TIF Curves, and Psychometric Scale Auditing

fn irt_dichotomous_cockpit(
    res: DichotomousIrtResult,
    scores: PersonScoreResult,
    diag: IrtScaleDiagnostics
) {
    let badge = if res.converged && diag.items_well_fitted {
        "/ᐠ˵- ⩊ -˵マ ✧ PSYCHOMETRIC SCALE CALIBRATED"
    } else {
        if res.converged {
            "/ᐠ˵- ⩊ -˵マ ✧ MODEL CONVERGED (CHECK ITEM FIT)"
        } else {
            "≽(◉˕ ◉ ≼マ MMLE-EM CONVERGENCE FAILURE"
        }
    };

    let mut b_min = 1.0e10;
    let mut b_max = -1.0e10;
    let mut sum_a = 0.0;
    for b in res.b_params {
        if b < b_min { b_min = b; }
        if b > b_max { b_max = b; }
    }
    for a in res.a_params {
        sum_a = sum_a + a;
    }
    let mean_a = sum_a / (0.0 + res.n_items);

    let min_sem = if diag.peak_information > 0.0 { 1.0 / sqrt(diag.peak_information) } else { 999.0 };

    let p = cockpit("GHL Psychometrics: Item Response Theory (IRT)", badge)
        |> cockpit_add_kv("Model Architecture", res.model_type)
        |> cockpit_add_kv("Calibrated Items (J)", format("{}", res.n_items))
        |> cockpit_add_kv("Sample Size (N)", format("{}", res.n_persons))
        |> cockpit_add_divider()
        |> cockpit_add_kv("EAP Empirical Reliability", format("{:.4}", scores.reliability))
        |> cockpit_add_kv("Mean Item Discrimination", format("{:.4}", mean_a))
        |> cockpit_add_kv("Difficulty Span (b_min)", format("{:.2}", b_min))
        |> cockpit_add_kv("Difficulty Span (b_max)", format("{:.2}", b_max))
        |> cockpit_add_divider()
        |> cockpit_add_kv("Peak Information I(θ*)", format("{:.4}", diag.peak_information))
        |> cockpit_add_kv("Peak Trajectory Theta", format("{:.2}", diag.peak_info_theta))
        |> cockpit_add_kv("Minimum Measurement SEM", format("{:.4}", min_sem))
        |> cockpit_add_kv("Marginal Log-Likelihood", format("{:.2}", res.log_likelihood))
        |> cockpit_add_divider()
        |> cockpit_add_line("Test Information Function (TIF) [-3.0 to +3.0]:")
        |> cockpit_add_line(sparkline(diag.tif_curve))
        |> cockpit_add_line("Conditional Measurement Error (SEM(θ)) Curve:")
        |> cockpit_add_line(sparkline(diag.sem_curve))
        |> cockpit_add_divider();

    let fit_msg = if diag.items_well_fitted {
        "/ᐠ˵- ⩊ -˵マ ✧ All items demonstrate productive Infit/Outfit MNSQ [0.60, 1.40]. Scale invariant across trait span."
    } else {
        "≽(◉˕ ◉ ≼マ Certain items exhibit Infit/Outfit deviation. Review item response wording or distractors."
    };
    let p2 = p |> cockpit_add_line(fit_msg);
    p2
}

fn render_irt_dichotomous_cockpit(
    res: DichotomousIrtResult,
    scores: PersonScoreResult,
    diag: IrtScaleDiagnostics
) {
    let p = irt_dichotomous_cockpit(res, scores, diag);
    show_cockpit(p);
}

fn irt_graded_cockpit(
    res: GradedResponseResult,
    scores: PersonScoreResult
) {
    let badge = if res.converged {
        "/ᐠ˵- ⩊ -˵マ ✧ GRADED RESPONSE SCALE CALIBRATED"
    } else {
        "≽(◉˕ ◉ ≼マ GRM ESTIMATION FAILURE"
    };

    let mut sum_a = 0.0;
    for a in res.a_params {
        sum_a = sum_a + a;
    }
    let mean_a = sum_a / (0.0 + res.n_items);

    let p = cockpit("GHL Psychometrics: Graded Response Model (GRM)", badge)
        |> cockpit_add_kv("Model Architecture", "Samejima Polytomous GRM (1969)")
        |> cockpit_add_kv("Polytomous Items (J)", format("{}", res.n_items))
        |> cockpit_add_kv("Ordered Categories (K)", format("{}", res.n_categories))
        |> cockpit_add_kv("Sample Size (N)", format("{}", res.n_persons))
        |> cockpit_add_divider()
        |> cockpit_add_kv("EAP Empirical Reliability", format("{:.4}", scores.reliability))
        |> cockpit_add_kv("Mean Slope Discrimination", format("{:.4}", mean_a))
        |> cockpit_add_kv("EM Iterations", format("{}", res.iterations))
        |> cockpit_add_kv("Marginal Log-Likelihood", format("{:.2}", res.log_likelihood))
        |> cockpit_add_divider()
        |> cockpit_add_line("/ᐠ˵- ⩊ -˵マ ✧ Ordered threshold structure confirmed. Cumulative boundaries partition psychological continuum.");
    p
}

fn render_irt_graded_cockpit(
    res: GradedResponseResult,
    scores: PersonScoreResult
) {
    let p = irt_graded_cockpit(res, scores);
    show_cockpit(p);
}

// =========================================================================
// 3. Differential Item Functioning (DIF) Telemetry Deck
// =========================================================================

fn render_dif_cockpit(dif_res: DifAnalysisResult) {
    let badge = if dif_res.n_flagged_severe == 0 && dif_res.n_flagged_moderate == 0 {
        "/ᐠ˵- ⩊ -˵マ ✧ NO ITEM BIAS DETECTED"
    } else {
        if dif_res.n_flagged_severe > 0 {
            "≽(◉˕ ◉ ≼マ SEVERE DIF BIAS DETECTED"
        } else {
            "≽(◉˕ ◉ ≼マ MODERATE DIF BIAS DETECTED"
        }
    };

    let p = cockpit("GHL Psychometrics: Differential Item Functioning (DIF)", badge)
        |> cockpit_add_kv("Methodology", "Mantel-Haenszel Contingency & ETS Delta Metric")
        |> cockpit_add_kv("Reference Group Count", format("{}", dif_res.reference_count))
        |> cockpit_add_kv("Focal Group Count", format("{}", dif_res.focal_count))
        |> cockpit_add_divider()
        |> cockpit_add_kv("Class A Items (Negligible)", format("{}", length(dif_res.items) - (dif_res.n_flagged_moderate + dif_res.n_flagged_severe)))
        |> cockpit_add_kv("Class B Items (Moderate)", format("{}", dif_res.n_flagged_moderate))
        |> cockpit_add_kv("Class C Items (Severe)", format("{}", dif_res.n_flagged_severe))
        |> cockpit_add_divider()
        |> cockpit_add_line(if dif_res.n_flagged_severe == 0 {
            "/ᐠ˵- ⩊ -˵マ ✧ Measurement invariance holds across demographic subgroups."
        } else {
            "≽(◉˕ ◉ ≼マ Flagged items violate demographic measurement invariance. Exclude from anchor sets."
        });

    show_cockpit(p);
}

// =========================================================================
// 4. Person Fit Diagnostics Telemetry Deck
// =========================================================================

fn render_person_fit_cockpit(pfit: PersonFitResult) {
    let badge = if pfit.n_aberrant == 0 {
        "/ᐠ˵- ⩊ -˵マ ✧ CLEAN RESPONSE PATTERNS"
    } else {
        "≽(◉˕ ◉ ≼マ ABERRANT RESPONDENTS DETECTED"
    };

    let p = cockpit("GHL Psychometrics: Person Fit Diagnostics", badge)
        |> cockpit_add_kv("Criterion", "Drasgow Standardized Log-Likelihood (Zh < -2.0)")
        |> cockpit_add_kv("Mean Zh Index", format("{:.4}", pfit.mean_zh))
        |> cockpit_add_kv("Aberrant Examinees Flagged", format("{}", pfit.n_aberrant))
        |> cockpit_add_divider()
        |> cockpit_add_line(if pfit.n_aberrant == 0 {
            "/ᐠ˵- ⩊ -˵マ ✧ No aberrant test-taking behavior detected. Scores reflect valid trait continuum."
        } else {
            "≽(◉˕ ◉ ≼マ Flagged examinees display irregular answer patterns (random guessing or cheating)."
        });

    show_cockpit(p);
}

// =========================================================================
// 5. Computerized Adaptive Testing (CAT) Telemetry Deck
// =========================================================================

fn render_cat_cockpit(session: CatSession) {
    let badge = if session.is_terminated {
        "/ᐠ˵- ⩊ -˵マ ✧ ADAPTIVE TEST CONVERGED"
    } else {
        "≽(◉˕ ◉ ≼マ SESSION IN PROGRESS"
    };

    let n_items_taken = length(session.items_administered);

    let p = cockpit("GHL Psychometrics: Adaptive Testing Engine (CAT)", badge)
        |> cockpit_add_kv("Selection Rule", "Maximum Fisher Information (MFI)")
        |> cockpit_add_kv("Items Administered", format("{}", n_items_taken))
        |> cockpit_add_kv("Final Trait Estimate (θ)", format("{:.4}", session.current_theta))
        |> cockpit_add_kv("Measurement Error (SEM)", format("{:.4}", session.current_sem))
        |> cockpit_add_divider()
        |> cockpit_add_line("Theta Convergence Trajectory:")
        |> cockpit_add_line(sparkline(session.theta_trajectory))
        |> cockpit_add_divider()
        |> cockpit_add_line("/ᐠ˵- ⩊ -˵マ ✧ Stopping threshold reached with minimal respondent burden.");

    show_cockpit(p);
}

// =========================================================================
// 6. Advanced Global Fit (M2) and Local Item Dependence (Q3) Cockpit Deck
// =========================================================================

fn render_advanced_fit_cockpit(audit: AdvancedFitAudit) {
    let badge = if audit.scale_certified {
        "/ᐠ˵- ⩊ -˵マ ✧ GLOBAL FIT & LOCAL INDEPENDENCE CONFIRMED"
    } else {
        if audit.q3.has_local_dependence {
            "/ᐠ ·•᷄ ˕ •᷅マ LOCAL ITEM DEPENDENCE (LID) DETECTED"
        } else {
            "≽(◉˕ ◉ ≼マ GLOBAL SPECIFICATION MISFIT"
        }
    };

    let mut p = cockpit("GHL Psychometrics: Advanced Fit & Local Independence", badge)
        |> cockpit_add_kv("Limited Information M2", format("{:.2}", audit.m2.m2_stat))
        |> cockpit_add_kv("Degrees of Freedom (df)", format("{}", audit.m2.df))
        |> cockpit_add_kv("M2 p-value (Asymptotic)", format("{:.4}", audit.m2.p_value))
        |> cockpit_add_kv("RMSEA_2 (Limited Info)", format("{:.4}", audit.m2.rmsea))
        |> cockpit_add_kv("Comparative Fit (CFI)", format("{:.4}", audit.m2.cfi))
        |> cockpit_add_kv("Tucker-Lewis Index (TLI)", format("{:.4}", audit.m2.tli))
        |> cockpit_add_divider()
        |> cockpit_add_kv("Yen Mean Residual Q3", format("{:.4}", audit.q3.mean_q3))
        |> cockpit_add_kv("Maximum Residual Q3", format("{:.4}", audit.q3.max_q3))
        |> cockpit_add_kv("Item Pairs Evaluated", format("{}", audit.q3.n_pairs))
        |> cockpit_add_kv("Flagged LID Item Pairs", format("{}", audit.q3.n_flagged_lid))
        |> cockpit_add_divider();

    if audit.q3.has_local_dependence {
        for f in 0..audit.q3.n_flagged_lid {
            let i1 = audit.q3.flagged_item_1[f];
            let i2 = audit.q3.flagged_item_2[f];
            let q_val = audit.q3.flagged_q3_val[f];
            let pair_msg = "Item " + format("{}", i1) + " <-> Item " + format("{}", i2) + ": Q3 = " + format("{:.3}", q_val) + " (> 0.20 threshold)";
            p = p |> cockpit_add_kv("LID Violation " + format("{}", f + 1), pair_msg);
        }
        p = p |> cockpit_add_divider();
    }

    let summary_msg = if audit.scale_certified {
        "/ᐠ˵- ⩊ -˵マ ✧ Empirical moments conform to low-dimensional manifold. No redundant items detected."
    } else {
        if audit.q3.has_local_dependence {
            "/ᐠ ·•᷄ ˕ •᷅マ Certain items share excess residual variance. Consider combining or revising content."
        } else {
            "≽(◉˕ ◉ ≼マ Model structure deviates from observed bivariate margins. Test multidimensionality."
        }
    };

    p = p |> cockpit_add_line(summary_msg);
    show_cockpit(p);
}

// =========================================================================
// 7. Canonical Bi-Factor Model & Unidimensionality Telemetry Deck
// =========================================================================

fn render_bfactor_cockpit(audit: BfactorAudit) {
    let res = audit.model;
    let badge = if res.essentially_unidimensional {
        "/ᐠ˵- ⩊ -˵マ ✧ ESSENTIALLY UNIDIMENSIONAL SCALE"
    } else {
        if res.converged {
            "/ᐠ ·•᷄ ˕ •᷅マ MULTIDIMENSIONAL SUB-FACTORS ACTIVE"
        } else {
            "≽(◉˕ ◉ ≼マ BI-FACTOR ESTIMATION FAILURE"
        }
    };

    let p = cockpit("GHL Psychometrics: Bi-Factor Structural Decomposition", badge)
        |> cockpit_add_kv("Model Architecture", "Gibbons & Hedeker (1992) Orthogonal Bi-Factor")
        |> cockpit_add_kv("Total Manifest Items (J)", format("{}", res.n_items))
        |> cockpit_add_kv("Specific Domain Factors (K)", format("{}", res.n_specific_factors))
        |> cockpit_add_kv("Sample Size (N)", format("{}", res.n_persons))
        |> cockpit_add_divider()
        |> cockpit_add_kv("Total Explained Common Variance (ECV)", format("{:.4}", res.ecv_total))
        |> cockpit_add_kv("Omega Hierarchical (ω_h)", format("{:.4}", res.omega_hierarchical))
        |> cockpit_add_kv("Omega Total (ω_t)", format("{:.4}", res.omega_total))
        |> cockpit_add_kv("Marginal Log-Likelihood", format("{:.2}", res.log_likelihood))
        |> cockpit_add_divider()
        |> cockpit_add_line("Item-Level Explained Common Variance (I-ECV):")
        |> cockpit_add_line(sparkline(res.item_ecv))
        |> cockpit_add_divider()
        |> cockpit_add_line(audit.recommendation);

    show_cockpit(p);
}

// =========================================================================
// 8. Multigroup LRT DIF Telemetry Deck (Uniform & Non-Uniform Bias)
// =========================================================================

fn render_lrt_dif_cockpit(audit: LrtDifAudit) {
    let mg = audit.model;
    let badge = if audit.scale_invariance_certified {
        "/ᐠ˵- ⩊ -˵マ ✧ MEASUREMENT INVARIANCE CONFIRMED"
    } else {
        if audit.n_flagged_non_uniform > 0 {
            "≽(◉˕ ◉ ≼マ SEVERE NON-UNIFORM DIF DETECTED"
        } else {
            "/ᐠ ·•᷄ ˕ •᷅マ UNIFORM DIF DETECTED (INTERCEPT SHIFT)"
        }
    };

    let mut p = cockpit("GHL Psychometrics: Multigroup Likelihood Ratio Test (LRT) DIF", badge)
        |> cockpit_add_kv("Methodology", "Thissen, Steinberg & Wainer (1993) Hierarchical LRT")
        |> cockpit_add_kv("Reference Group Count", format("{}", mg.n_reference))
        |> cockpit_add_kv("Focal Group Count", format("{}", mg.n_focal))
        |> cockpit_add_kv("Focal Group Impact (μ_foc)", format("{:.4}", mg.focal_mean))
        |> cockpit_add_divider()
        |> cockpit_add_kv("Uniform DIF Items (Δd, df=1)", format("{}", audit.n_flagged_uniform))
        |> cockpit_add_kv("Non-Uniform DIF Items (Δa, df=1)", format("{}", audit.n_flagged_non_uniform))
        |> cockpit_add_kv("Total Flagged Items (Omnibus, df=2)", format("{}", audit.n_flagged_omnibus))
        |> cockpit_add_divider();

    if audit.n_flagged_omnibus > 0 {
        for j in 0..length(audit.items) {
            let it = audit.items[j];
            if it.is_flagged {
                let msg = it.dif_type + " DIF (Favors " + it.favored_group + ", LRT=" + format("{:.2}", it.lrt_omnibus) + ", p=" + format("{:.4}", it.p_omnibus) + ")";
                p = p |> cockpit_add_kv("Item " + format("{}", it.item_index), msg);
            }
        }
        p = p |> cockpit_add_divider();
    }

    let summary_msg = if audit.scale_invariance_certified {
        "/ᐠ˵- ⩊ -˵マ ✧ Item parameters are invariant across demographic groups. Scores are fair and unbiased."
    } else {
        if audit.n_flagged_non_uniform > 0 {
            "≽(◉˕ ◉ ≼マ Items exhibit non-parallel ICC curves. Examine item discrimination across groups."
        } else {
            "/ᐠ ·•᷄ ˕ •᷅マ Items exhibit uniform difficulty offsets. Consider split-item equating or revision."
        }
    };

    p = p |> cockpit_add_line(summary_msg);
    show_cockpit(p);
}

// =========================================================================
// 9. Metropolis-Hastings Robbins-Monro (MHRM) High-Dimensional Deck
// =========================================================================

fn render_mhrm_cockpit(audit: MhrmAudit) {
    let m = audit.model;
    let badge = if audit.stochastic_efficiency_certified {
        "/ᐠ˵- ⩊ -˵マ ✧ HIGH-DIMENSIONAL STOCHASTIC CONVERGENCE"
    } else {
        "≽(◉˕ ◉ ≼マ STOCHASTIC CHAIN MIXING SUB-OPTIMAL"
    };

    let mut mdisc_vals = [];
    for j in 0..length(m.items) {
        let it = m.items[j];
        mdisc_vals = append(mdisc_vals, it.mdisc);
    }

    let p = cockpit("GHL Psychometrics: Metropolis-Hastings Robbins-Monro (MHRM)", badge)
        |> cockpit_add_kv("Estimation Method", "Stochastic Approximation MHRM (Cai, 2010)")
        |> cockpit_add_kv("Latent Dimensions (D)", format("{}", m.n_dimensions))
        |> cockpit_add_kv("Manifest Items (J)", format("{}", m.n_items))
        |> cockpit_add_kv("Sample Size (N)", format("{}", m.n_persons))
        |> cockpit_add_divider()
        |> cockpit_add_kv("Quadrature Nodes Avoided", format("{:.0} (15^D)", audit.quadrature_nodes_avoided))
        |> cockpit_add_kv("Total Stochastic Cycles", format("{}", m.total_cycles))
        |> cockpit_add_kv("Polyak-Ruppert Cycles", format("{}", m.stage3_polyak_cycles))
        |> cockpit_add_kv("M-H Proposal Acceptance", format("{:.1}%", m.acceptance_rate * 100.0))
        |> cockpit_add_kv("Adaptive Proposal SD (σ)", format("{:.3}", m.proposal_sd))
        |> cockpit_add_kv("Final R-M Gain (γ)", format("{:.4}", m.final_gain))
        |> cockpit_add_kv("Marginal Log-Likelihood", format("{:.2}", m.log_likelihood))
        |> cockpit_add_divider()
        |> cockpit_add_line("Multidimensional Discrimination (MDISC) Profile:")
        |> cockpit_add_line(sparkline(mdisc_vals))
        |> cockpit_add_divider()
        |> cockpit_add_line(audit.recommendation);

    show_cockpit(p);
}




