// packages/ghl_survival/src/plots.gh
// Publication-Quality Grammar of Graphics Visualizations for Survival Analysis (APA Standard)

/// Generates a Publication-Quality Kaplan-Meier Survival Curve Plot.
/// Defaults to showing 95% Greenwood confidence intervals with APA theme.
fn plot_km_curve(km: KMResult) -> Plot {
    plot_km_with_ci(km, true)
}

/// Generates a Kaplan-Meier Survival Curve Plot with configurable confidence intervals.
fn plot_km_with_ci(km: KMResult, show_ci: bool) -> Plot {
    let n = length(km.timeline);
    if n == 0 {
        let df_empty = dataframe {
            time: [0.0],
            survival: [1.0]
        };
        return df_empty |> plot(aes(col("time"), col("survival")))
                        |> geom_line()
                        |> labs("Kaplan-Meier Survival Probability S(t)")
                        |> theme_apa();
    }

    // Build step curve trajectory starting at t = 0, S(0) = 1.0
    let mut step_times = [0.0];
    let mut step_survs = [1.0];
    let mut step_lows = [1.0];
    let mut step_highs = [1.0];

    let mut prev_t = 0.0;
    let mut prev_s = 1.0;
    let mut prev_l = 1.0;
    let mut prev_h = 1.0;

    for i in 0..n {
        let curr_t = km.timeline[i];
        let curr_s = km.survival[i];
        let curr_l = km.ci_lower[i];
        let curr_h = km.ci_upper[i];

        // Horizontal step to curr_t at prev_s
        step_times = append(step_times, curr_t);
        step_survs = append(step_survs, prev_s);
        step_lows = append(step_lows, prev_l);
        step_highs = append(step_highs, prev_h);

        // Vertical drop at curr_t to curr_s
        step_times = append(step_times, curr_t);
        step_survs = append(step_survs, curr_s);
        step_lows = append(step_lows, curr_l);
        step_highs = append(step_highs, curr_h);

        prev_t = curr_t;
        prev_s = curr_s;
        prev_l = curr_l;
        prev_h = curr_h;
    }

    let df_step = dataframe {
        time: step_times,
        survival: step_survs,
        conf_low: step_lows,
        conf_high: step_highs
    };

    let p = df_step |> plot(aes(col("time"), col("survival")))
                    |> geom_line();

    let p2 = if show_ci {
        p |> geom_line(aes(col("time"), col("conf_high")))
          |> geom_line(aes(col("time"), col("conf_low")))
          |> labs("Kaplan-Meier Survival Probability S(t) with 95% Greenwood CI")
    } else {
        p |> labs("Kaplan-Meier Survival Probability S(t)")
    };

    p2 |> theme_apa()
}

/// Generates a Cumulative Hazard Function Plot from Nelson-Aalen estimation.
fn plot_cumulative_hazard(na: NelsonAalenResult) -> Plot {
    let df_na = dataframe {
        time: na.timeline,
        hazard: na.cumulative_hazard
    };

    df_na |> plot(aes(col("time"), col("hazard")))
          |> geom_line()
          |> labs("Nelson-Aalen Cumulative Hazard Function H(t)")
          |> theme_apa()
}

/// Generates a Forest Plot comparing Multivariate Cox Hazard Ratios with 95% Confidence Intervals.
fn plot_hazard_ratios(cox: MultivariateCoxResult) -> Plot {
    let df_forest = dataframe {
        covariate: cox.covariates,
        hazard_ratio: cox.hazard_ratios,
        ci_lower: cox.hr_ci_lower,
        ci_upper: cox.hr_ci_upper
    };

    df_forest |> plot(aes(col("covariate"), col("hazard_ratio")))
              |> geom_point()
              |> labs("Multivariate Cox Proportional Hazards: Adjusted Hazard Ratios (95% CI)")
              |> theme_apa()
}
