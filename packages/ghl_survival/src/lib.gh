// packages/ghl_survival/src/lib.gh
// Comprehensive Survival & Time-to-Event Analysis Suite in Pure GHL

struct SurvivalPipelineAudit {
    km: KMResult,
    logrank: LogRankResult,
    cox: CoxResult,
    overall_badge: String
}

fn audit_survival_pipeline(
    times: Vector,
    events: Vector,
    treatments: Vector
) -> SurvivalPipelineAudit {
    let km = fit_kaplan_meier(times, events);
    let lr = logrank_test(times, events, treatments);
    let cox = fit_cox_ph(times, events, treatments);

    let badge = if cox.converged {
        "/ᐠ˵- ⩊ -˵マ ✧ SURVIVAL ANALYSIS CERTIFIED"
    } else {
        "≽(◉˕ ◉ ≼マ MODEL WARNING: CHECK LIKELIHOOD"
    };

    SurvivalPipelineAudit {
        km: km,
        logrank: lr,
        cox: cox,
        overall_badge: badge
    }
}

fn render_survival_report(audit: SurvivalPipelineAudit) {
    render_km_cockpit(audit.km);
    render_logrank_cockpit(audit.logrank);
    render_cox_cockpit(audit.cox);

    let summary = cockpit("Survival Pipeline: Executive Audit", audit.overall_badge)
        |> cockpit_add_kv("Total Observations", format("{}", audit.km.n_total))
        |> cockpit_add_kv("Observed Mortality / Events", format("{}", audit.km.n_events))
        |> cockpit_add_kv("Log-Rank Chi-Square", format("{:.4}", audit.logrank.chisq_stat))
        |> cockpit_add_kv("Log-Rank P-Value", format("{:.6}", audit.logrank.p_value))
        |> cockpit_add_divider()
        |> cockpit_add_kv("Cox Hazard Ratio", format("{:.4}", audit.cox.hazard_ratio))
        |> cockpit_add_kv("Cox 95% CI Lower", format("{:.4}", audit.cox.hr_ci_lower))
        |> cockpit_add_kv("Cox 95% CI Upper", format("{:.4}", audit.cox.hr_ci_upper))
        |> cockpit_add_kv("Cox P-Value", format("{:.6}", audit.cox.p_value))
        |> cockpit_add_divider()
        |> cockpit_add_line("/ᐠ˵- ⩊ -˵マ ✧ SURVIVAL METRICS VALIDATED: Non-parametric, rank, and semiparametric alignment verified.");
    show_cockpit(summary);
}
