// packages/ghl_multilevel/tests/multilevel_test.gh
// Comprehensive integration test suite for ghl_multilevel hierarchical mixed models

println("Running ghl_multilevel comprehensive test suite...");

// =========================================================================
// 1. Generate Synthetic Clustered Hierarchical Dataset (J = 5 clusters, n_j = 8, N = 40)
// True parameters: beta0 = 3.0, beta1 = 1.5, u_0j in [-2, -1, 0, 1, 2], u_1j in [-0.4, -0.2, 0, 0.2, 0.4]
// =========================================================================
let n_groups = 5;
let obs_per_group = 8;
let total_n = n_groups * obs_per_group;

let group_u0 = [-2.0, -1.0, 0.0, 1.0, 2.0];
let group_u1 = [-0.4, -0.2, 0.0, 0.2, 0.4];
let noise = random_normal(total_n, 0.0, 0.15, 99);

let mut y_vec = [];
let mut x_vec = [];
let mut g_vec = [];

let mut row_idx = 0;
for g in 0..n_groups {
    let fg = 0.0 + g;
    let u0_j = group_u0[g];
    let u1_j = group_u1[g];

    for i in 0..obs_per_group {
        let fi = 0.0 + i;
        let x_val = 1.0 + (0.3 * fi);
        let e_val = noise[row_idx];
        let y_val = 3.0 + u0_j + ((1.5 + u1_j) * x_val) + e_val;

        x_vec = append(x_vec, x_val);
        y_vec = append(y_vec, y_val);
        g_vec = append(g_vec, fg);
        row_idx = row_idx + 1;
    }
}

let df_multi = dataframe {
    y: y_vec,
    x: x_vec,
    group: g_vec
};

// =========================================================================
// 2. Random Intercepts Mixed-Effects Model Estimation
// =========================================================================
println("Testing Random Intercepts Mixed Model...");
let model_ri = fit_mixed_model(y_vec, x_vec, g_vec, n_groups);
if !model_ri.converged {
    panic("Random intercepts EM algorithm must converge");
}
if model_ri.beta0 < 1.0 || model_ri.beta0 > 5.0 {
    panic("Fixed intercept beta0 must be close to 3.0");
}
if model_ri.beta1 < 1.0 || model_ri.beta1 > 2.0 {
    panic("Fixed slope beta1 must be close to 1.5");
}
if model_ri.tau2_intercept <= 0.0 {
    panic("Between-group variance tau0^2 must be positive");
}
if model_ri.sigma2_residual <= 0.0 {
    panic("Residual variance sigma^2 must be positive");
}
if model_ri.icc <= 0.20 {
    panic("ICC must reflect substantial clustering (ICC > 0.20)");
}
render_mixed_model_cockpit(model_ri);

// =========================================================================
// 3. Random Slopes & Intercepts Mixed-Effects Model Estimation
// =========================================================================
println("Testing Random Slopes & Intercepts Mixed Model...");
let model_rs = audit_random_slopes(y_vec, x_vec, g_vec, n_groups);
if !model_rs.converged {
    panic("Random slopes algorithm must converge");
}
if model_rs.tau0_sd <= 0.0 {
    panic("Random intercept SD tau0 must be strictly positive");
}
if model_rs.tau1_sd <= 0.0 {
    panic("Random slope SD tau1 must be strictly positive");
}
if model_rs.rho_correlation < -1.0 || model_rs.rho_correlation > 1.0 {
    panic("Correlation rho must be bounded in [-1, 1]");
}

// =========================================================================
// 4. Multilevel Diagnostics: Design Effect, Effective N, and Shrinkage
// =========================================================================
println("Testing Multilevel Diagnostics...");
let diag = compute_multilevel_diagnostics(model_ri);
if !diag.clustering_justified {
    panic("Hierarchical clustering must be justified");
}
if diag.design_effect <= 1.0 {
    panic("Kish Design Effect must be > 1.0 in clustered data");
}
if diag.effective_sample_size >= 40.0 {
    panic("Effective sample size must be smaller than nominal sample size due to ICC");
}
render_multilevel_diagnostics_cockpit(diag);

// =========================================================================
// 5. Model Comparison: Nakagawa R^2 and Likelihood Ratio Test (LRT)
// =========================================================================
println("Testing Model Comparison (Nakagawa R^2 and LRT)...");
let lrt_res = audit_model_comparison(model_ri, model_rs, y_vec, x_vec);
if lrt_res.lrt_statistic < 0.0 {
    panic("LRT statistic must be non-negative");
}

let r2_res = compute_nakagawa_r2(y_vec, x_vec, model_ri.beta0, model_ri.beta1, model_ri.tau2_intercept, model_ri.sigma2_residual);
if r2_res.r2_marginal <= 0.0 || r2_res.r2_marginal > 1.0 {
    panic("Marginal R^2 must be in (0, 1]");
}
if r2_res.r2_conditional < r2_res.r2_marginal || r2_res.r2_conditional > 1.0 {
    panic("Conditional R^2 must be >= Marginal R^2 and <= 1.0");
}

// =========================================================================
// 6. Grammar of Graphics Plotting Generators
// =========================================================================
println("Testing Grammar of Graphics Plotting Generators...");
let p_blup = plot_blup_caterpillar(model_ri);
let p_traj = plot_multilevel_trajectories(df_multi, "group", "x", "y");

// =========================================================================
// 7. Complete Multilevel Pipeline Executive Audit
// =========================================================================
println("Testing Complete Multilevel Pipeline Audit...");
let audit = audit_multilevel_pipeline(y_vec, x_vec, g_vec, n_groups);
if !audit.certified {
    panic("Multilevel pipeline audit must certify hierarchical model");
}
render_multilevel_report(audit);

println("All ghl_multilevel tests passed successfully! /ᐠ˵- ⩊ -˵マ ✧");
