// packages/ghl_multilevel/src/lib.gh
// Hierarchical Linear Mixed-Effects Models Suite in Pure GHL

struct MultilevelAudit {
    mixed: MixedModelResult,
    diagnostics: MultilevelDiagnostics,
    certified: bool
}

fn audit_multilevel_pipeline(y: Vector, x: Vector, groups: Vector, n_groups: i64) -> MultilevelAudit {
    let m_res = fit_mixed_model(y, x, groups, n_groups);
    let d_res = compute_multilevel_diagnostics(m_res);

    let cert = m_res.converged && d_res.clustering_justified;

    MultilevelAudit {
        mixed: m_res,
        diagnostics: d_res,
        certified: cert
    }
}

fn render_multilevel_report(audit: MultilevelAudit) {
    render_mixed_model_cockpit(audit.mixed);
    render_multilevel_diagnostics_cockpit(audit.diagnostics);

    let badge = if audit.certified {
        "/ᐠ˵- ⩊ -˵マ ✧ HIERARCHICAL MODEL CERTIFIED"
    } else {
        "≽(◉˕ ◉ ≼マ MODEL REVIEW RECOMMENDED"
    };

    let summary = cockpit("Multilevel Modeling: Executive Deck", badge)
        |> cockpit_add_kv("Total Sample (N)", format("{}", audit.mixed.n_obs))
        |> cockpit_add_kv("Number of Clusters (J)", format("{}", audit.mixed.n_groups))
        |> cockpit_add_divider()
        |> cockpit_add_kv("Fixed Intercept (β0)", format("{:.4}", audit.mixed.beta0))
        |> cockpit_add_kv("Fixed Slope (β1)", format("{:.4}", audit.mixed.beta1))
        |> cockpit_add_divider()
        |> cockpit_add_kv("Between-Group Variance (τ0²)", format("{:.4}", audit.mixed.tau2_intercept))
        |> cockpit_add_kv("Residual Variance (σ²)", format("{:.4}", audit.mixed.sigma2_residual))
        |> cockpit_add_kv("Intraclass Correlation (ICC)", format("{:.4}", audit.mixed.icc))
        |> cockpit_add_kv("Design Effect (Deff)", format("{:.4}", audit.diagnostics.design_effect))
        |> cockpit_add_divider()
        |> cockpit_add_line("/ᐠ˵- ⩊ -˵マ ✧ MIXED-EFFECTS VALIDATED: Hierarchical variance decomposition and random intercepts confirmed.");
    show_cockpit(summary);
}
