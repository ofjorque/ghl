// GHL Real Data Validation: Airline On-Time Performance
// Tests high-cardinality categorical variables, massive real flight records
// (ASA Data Expo / Harvard Dataverse: 2.38M rows), relational hash joins,
// multi-key group_by, aggregations, and on-time performance (OTP) metrics.

fn load_flight_dataset() -> DataFrame {
    let massive_path = "validation/data/airline_120m.csv";
    if file_exists(massive_path) {
        println("Ingesting Authentic ASA Airline On-Time Dataset from disk: ", massive_path);
        let df = read_csv(massive_path);
        println("Total flights in dataset:", nrow(df));
        // Take a high-volume sample of 100,000 flights for fast relational benchmarks
        head(df, 100000)
    } else {
        println("Notice: Massive dataset not found at ", massive_path, ". Using embedded fallback sample.");
        parse_csv(
            "carrier,origin,dest,dep_delay,arr_delay,air_time,distance\n" +
            "AA,JFK,LAX,-2.0,5.0,320.0,2475.0\n" +
            "AA,ORD,DFW,5.0,10.0,130.0,802.0\n" +
            "AA,DFW,ORD,45.0,52.0,135.0,802.0\n" +
            "AA,LAX,JFK,0.0,-5.0,315.0,2475.0\n" +
            "DL,ATL,LAX,12.0,8.0,260.0,1947.0\n" +
            "DL,JFK,ATL,-1.0,-8.0,120.0,760.0\n" +
            "DL,LAX,ORD,3.0,0.0,240.0,1744.0\n" +
            "DL,ORD,JFK,25.0,30.0,125.0,760.0\n" +
            "UA,ORD,DEN,18.0,22.0,140.0,888.0\n" +
            "UA,SFO,ORD,50.0,55.0,250.0,1846.0\n" +
            "UA,DEN,ORD,-4.0,-2.0,145.0,888.0\n" +
            "UA,EWR,SFO,8.0,12.0,340.0,2565.0\n" +
            "WN,MDW,DAL,2.0,-1.0,130.0,793.0\n" +
            "WN,DAL,HOU,30.0,35.0,55.0,239.0\n" +
            "WN,HOU,MDW,15.0,18.0,150.0,937.0\n" +
            "WN,PHX,LAS,-3.0,-7.0,60.0,255.0\n" +
            "B6,JFK,BOS,4.0,12.0,45.0,187.0\n" +
            "B6,BOS,JFK,-2.0,-4.0,42.0,187.0\n" +
            "B6,FLL,MCO,60.0,75.0,40.0,177.0\n" +
            "B6,MCO,FLL,10.0,8.0,41.0,177.0\n" +
            "AS,SEA,PDX,-5.0,-10.0,35.0,129.0\n" +
            "AS,PDX,SEA,0.0,-2.0,33.0,129.0\n" +
            "AS,SFO,ANC,14.0,20.0,220.0,2016.0\n" +
            "AS,ANC,SEA,2.0,-1.0,225.0,2016.0\n"
        )
    }
}

println("=== 1. Flight Performance Dataset Ingestion ===");
let raw_flights = load_flight_dataset();

println("Flight Records Selected for Benchmark:", nrow(raw_flights), "rows,", ncol(raw_flights), "columns");
pounce(nrow(raw_flights) >= 24, "Total flights must be at least 24");

let is_real_schema = ncol(raw_flights) >= 20;

// Normalize column names if using the real ASA Data Expo schema
let flights = if is_real_schema {
    raw_flights
        |> rename("UniqueCarrier", "carrier")
        |> rename("Origin", "origin")
        |> rename("Dest", "dest")
        |> rename("DepDelay", "dep_delay")
        |> rename("ArrDelay", "arr_delay")
        |> rename("Distance", "distance")
        |> rename("AirTime", "air_time")
} else {
    raw_flights
};

println("\n=== 2. Master Tables & Relational Hash Joins ===");

let carriers_master_path = "validation/data/carriers_master.csv";
let carriers = if file_exists(carriers_master_path) {
    println("Using Authentic Carriers Catalog from Harvard Dataverse: ", carriers_master_path);
    read_csv(carriers_master_path) |> rename("Code", "carrier") |> rename("Description", "carrier_name")
} else {
    parse_csv(
        "carrier,carrier_name\n" +
        "AA,American Airlines\n" +
        "DL,Delta Air Lines\n" +
        "UA,United Airlines\n" +
        "WN,Southwest Airlines\n" +
        "B6,JetBlue Airways\n" +
        "AS,Alaska Airlines\n" +
        "NK,Spirit Airlines\n" +
        "XE,ExpressJet\n"
    )
};

let airports_master_path = "validation/data/airports_master.csv";
let airports = if file_exists(airports_master_path) {
    println("Using Authentic Airports Catalog from Harvard Dataverse: ", airports_master_path);
    read_csv(airports_master_path) |> rename("iata", "origin")
} else {
    parse_csv(
        "origin,city,state\n" +
        "JFK,New York,NY\n" +
        "LAX,Los Angeles,CA\n" +
        "ORD,Chicago,IL\n" +
        "ATL,Atlanta,GA\n" +
        "DFW,Dallas,TX\n" +
        "SFO,San Francisco,CA\n" +
        "SEA,Seattle,WA\n" +
        "BOS,Boston,MA\n" +
        "DEN,Denver,CO\n" +
        "IAH,Houston,TX\n" +
        "PHX,Phoenix,AZ\n" +
        "CLT,Charlotte,NC\n" +
        "HOU,Houston,TX\n" +
        "MDW,Chicago,IL\n" +
        "DAL,Dallas,TX\n" +
        "FLL,Ft Lauderdale,FL\n" +
        "MCO,Orlando,FL\n" +
        "PDX,Portland,OR\n" +
        "ANC,Anchorage,AK\n" +
        "LIT,Little Rock,AR\n" +
        "MAF,Midland,TX\n"
    )
};

// Left join flights with carrier catalog to attach full carrier name
let flights_with_carrier = flights |> left_join(carriers, carrier);
println("Joined with Carrier Catalog:", nrow(flights_with_carrier), "rows");
pounce(nrow(flights_with_carrier) == nrow(flights), "Left join must preserve all flight records");

// Inner join flights with airports catalog on origin
let flights_matched_origin = flights |> inner_join(airports, origin);
println("Matched with Airport Catalog (Origin):", nrow(flights_matched_origin), "rows");
pounce(nrow(flights_matched_origin) > 0, "Inner join should retain matched hub airports");

println("\n=== 3. High-Cardinality Grouped Aggregations ===");

// Group by carrier and compute flight volume and distance
let carrier_summary = flights |> group_by(["carrier"]) |> summarize(
    total_distance = sum(distance),
    flight_count = count()
);

println("Carrier Summary Table:");
println(carrier_summary);
pounce(nrow(carrier_summary) >= 2, "Carrier summary should aggregate carrier groups");

// Multi-key grouping: carrier and origin
let carrier_origin_summary = flights |> group_by(["carrier", "origin"]) |> summarize(
    total_distance = sum(distance),
    n = count()
);
println("Multi-key Grouping (Carrier x Origin):", nrow(carrier_origin_summary), "routes");
pounce(nrow(carrier_origin_summary) >= 10, "Should aggregate carrier-origin flight routes");

println("\n=== 4. On-Time Performance (OTP) Calculations ===");
// In real flight records, cancelled flights have NA delays; treat NA as not on-time
let arr_delays = flights |> pull("arr_delay");
let valid_delays = if_else(is_na(arr_delays), 999.0, arr_delays);
let on_time_indicator = if_else(valid_delays <= 15.0, 1.0, 0.0);
let overall_otp = mean(on_time_indicator);
println("Systemwide On-Time Arrival Rate (<= 15m delay):", overall_otp * 100.0, "%");
pounce(overall_otp > 0.10 && overall_otp < 0.95, "System OTP should be in realistic aviation percentage range");

println("(=^･ω･^=) Airline On-Time Performance Validation passed successfully!");
