// NIST StRD Longley Benchmark in pure GHL
// Tests multicollinear OLS regression against NIST certified values.

let y = [
    60323.0, 61122.0, 60171.0, 61187.0, 63221.0, 63639.0, 64989.0, 63761.0,
    66019.0, 67857.0, 68169.0, 66513.0, 68655.0, 69564.0, 69331.0, 70551.0
];

let x1 = [
    83.0, 88.5, 88.2, 89.5, 96.2, 98.1, 99.0, 100.0,
    101.2, 104.6, 108.4, 110.8, 112.6, 114.2, 115.7, 116.9
];

let x2 = [
    234289.0, 259426.0, 258054.0, 284599.0, 328975.0, 346999.0, 365385.0, 363112.0,
    397469.0, 419180.0, 442769.0, 444546.0, 482704.0, 502601.0, 518173.0, 554894.0
];

let x3 = [
    2356.0, 2325.0, 3682.0, 3351.0, 2099.0, 1932.0, 1870.0, 3578.0,
    2904.0, 2822.0, 2936.0, 4681.0, 3813.0, 3931.0, 4806.0, 4007.0
];

let x4 = [
    1590.0, 1456.0, 1616.0, 1650.0, 3099.0, 3594.0, 3547.0, 3350.0,
    3048.0, 2857.0, 2798.0, 2637.0, 2552.0, 2514.0, 2572.0, 2827.0
];

let x5 = [
    107608.0, 108632.0, 109773.0, 110929.0, 112075.0, 113270.0, 115094.0, 116219.0,
    117388.0, 118734.0, 120445.0, 121950.0, 123366.0, 125368.0, 127852.0, 130081.0
];

let x6 = [
    1947.0, 1948.0, 1949.0, 1950.0, 1951.0, 1952.0, 1953.0, 1954.0,
    1955.0, 1956.0, 1957.0, 1958.0, 1959.0, 1960.0, 1961.0, 1962.0
];

let df = dataframe {
    y: y,
    x1: x1,
    x2: x2,
    x3: x3,
    x4: x4,
    x5: x5,
    x6: x6
};

println("=== NIST StRD Longley Regression in Pure GHL ===");
let model = ols(y ~ x1 + x2 + x3 + x4 + x5 + x6, df);

summary(model);

let betas = coef(model);
println("Fitted Coefficients:", betas);

// Certified NIST values:
// Intercept: -3482258.63459582
// x1: 15.0618722713733
// x2: -0.0358191792925910
// x3: -2.02022980381683
// x4: -1.03322686704140
// x5: -0.0511041056535807
// x6: 1829.15146461355

// Check Intercept precision (within relative 1e-4)
let b0 = betas[0];
let b0_diff = abs((b0 - (-3482258.63459582)) / 3482258.63459582);
pounce(b0_diff < 0.0001, "b0 precision");

// Check x6 (Year) precision
let b6 = betas[6];
let b6_diff = abs((b6 - 1829.15146461355) / 1829.15146461355);
pounce(b6_diff < 0.0001, "b6 precision");

println("(=^･ω･^=) NIST StRD Longley certified precision passed!");
