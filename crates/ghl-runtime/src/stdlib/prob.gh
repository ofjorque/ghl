// ----------------------------------------------------------------------------
// 5. Gamma Distribution
// ----------------------------------------------------------------------------

struct Gamma {
    shape: f64,
    rate: f64
}

impl Gamma {
    fn pdf(&self, x: any) -> any {
        return gamma_pdf(x, self.shape, self.rate);
    }

    fn cdf(&self, q: any) -> any {
        return gamma_cdf(q, self.shape, self.rate);
    }

    fn quantile(&self, p: any) -> any {
        return gamma_quantile(p, self.shape, self.rate);
    }

    fn sample(&self, n: any) -> any {
        return random_gamma(n, self.shape, 1.0 / self.rate, NA);
    }

    fn sample_seed(&self, n: any, seed: any) -> any {
        return random_gamma(n, self.shape, 1.0 / self.rate, seed);
    }
}

fn gamma_dist(shape: any, rate: any) -> Gamma {
    return Gamma { shape: shape, rate: rate };
}

