// ============================================================================
// GHL Standard Library: Probability & Statistical Inference (`std::prob`)
// RFC 15 / Roadmap 08 Parte E: First-Class Probability Distributions
// ============================================================================

// ----------------------------------------------------------------------------
// 1. Normal Distribution (Gaussian)
// ----------------------------------------------------------------------------

struct Normal {
    mean: f64,
    sd: f64
}

impl Normal {
    fn pdf(&self, x: any) -> any {
        return normal_pdf(x, self.mean, self.sd);
    }

    fn cdf(&self, q: any) -> any {
        return normal_cdf(q, self.mean, self.sd);
    }

    fn quantile(&self, p: any) -> any {
        return normal_quantile(p, self.mean, self.sd);
    }

    fn sample(&self, n: any) -> any {
        return random_normal(n, self.mean, self.sd, NA);
    }

    fn sample_seed(&self, n: any, seed: any) -> any {
        return random_normal(n, self.mean, self.sd, seed);
    }
}

fn normal(mean: any, sd: any) -> Normal {
    return Normal { mean: mean, sd: sd };
}

// ----------------------------------------------------------------------------
// 2. Student's t-Distribution
// ----------------------------------------------------------------------------

struct StudentT {
    df: f64
}

impl StudentT {
    fn pdf(&self, x: any) -> any {
        return student_t_pdf(x, self.df);
    }

    fn cdf(&self, q: any) -> any {
        return student_t_cdf(q, self.df);
    }

    fn quantile(&self, p: any) -> any {
        return student_t_quantile(p, self.df);
    }

    fn sample(&self, n: any) -> any {
        return random_student_t(n, self.df, 0.0, 1.0, NA);
    }

    fn sample_seed(&self, n: any, seed: any) -> any {
        return random_student_t(n, self.df, 0.0, 1.0, seed);
    }
}

fn student_t(df: any) -> StudentT {
    return StudentT { df: df };
}

// ----------------------------------------------------------------------------
// 3. Fisher-Snedecor (F) Distribution
// ----------------------------------------------------------------------------

struct FisherF {
    df1: f64,
    df2: f64
}

impl FisherF {
    fn pdf(&self, x: any) -> any {
        return f_dist_pdf(x, self.df1, self.df2);
    }

    fn cdf(&self, q: any) -> any {
        return f_dist_cdf(q, self.df1, self.df2);
    }

    fn quantile(&self, p: any) -> any {
        return f_dist_quantile(p, self.df1, self.df2);
    }

    fn sample(&self, n: any) -> any {
        return random_f_dist(n, self.df1, self.df2, NA);
    }

    fn sample_seed(&self, n: any, seed: any) -> any {
        return random_f_dist(n, self.df1, self.df2, seed);
    }
}

fn fisher_f(df1: any, df2: any) -> FisherF {
    return FisherF { df1: df1, df2: df2 };
}

