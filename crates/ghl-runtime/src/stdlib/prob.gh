// ----------------------------------------------------------------------------
// 9. Binomial Distribution
// ----------------------------------------------------------------------------

struct Binomial {
    size: f64,
    prob: f64
}

impl Binomial {
    fn pmf(&self, k: any) -> any {
        return binomial_pmf(k, self.size, self.prob);
    }

    fn cdf(&self, k: any) -> any {
        return binomial_cdf(k, self.size, self.prob);
    }

    fn quantile(&self, p: any) -> any {
        return binomial_quantile(p, self.size, self.prob);
    }

    fn sample(&self, n: any) -> any {
        return random_binomial(n, self.size, self.prob, NA);
    }

    fn sample_seed(&self, n: any, seed: any) -> any {
        return random_binomial(n, self.size, self.prob, seed);
    }
}

fn binomial(size: any, prob: any) -> Binomial {
    return Binomial { size: size, prob: prob };
}

// ----------------------------------------------------------------------------
// 10. Poisson Distribution
// ----------------------------------------------------------------------------

struct Poisson {
    lambda: f64
}

impl Poisson {
    fn pmf(&self, k: any) -> any {
        return poisson_pmf(k, self.lambda);
    }

    fn cdf(&self, k: any) -> any {
        return poisson_cdf(k, self.lambda);
    }

    fn quantile(&self, p: any) -> any {
        return poisson_quantile(p, self.lambda);
    }

    fn sample(&self, n: any) -> any {
        return random_poisson(n, self.lambda, NA);
    }

    fn sample_seed(&self, n: any, seed: any) -> any {
        return random_poisson(n, self.lambda, seed);
    }
}

fn poisson_dist(lambda: any) -> Poisson {
    return Poisson { lambda: lambda };
}

// ============================================================================
// Statistical Inference Helpers
// ============================================================================

struct ConfidenceInterval {
    estimate: f64,
    std_error: f64,
    conf_low: f64,
    conf_high: f64,
    level: f64,
    df_table: DataFrame
}

impl ConfidenceInterval {
    fn tidy(&self) -> DataFrame {
        return self.df_table;
    }

    fn glance(&self) -> DataFrame {
        return self.df_table;
    }
}

fn conf_int(estimate: any, se: any, dist: any, level: any) -> ConfidenceInterval {
    let alpha = 1.0 - level;
    let crit = dist.quantile(1.0 - alpha / 2.0);
    let low = estimate - crit * se;
    let high = estimate + crit * se;

    let df_table = dataframe {
        estimate: [estimate],
        std_error: [se],
        conf_low: [low],
        conf_high: [high],
        level: [level]
    };

    return ConfidenceInterval {
        estimate: estimate,
        std_error: se,
        conf_low: low,
        conf_high: high,
        level: level,
        df_table: df_table
    };
}

fn p_value(stat: any, dist: any, alternative: any) -> f64 {
    if alternative == "two_sided" || alternative == "two.sided" || alternative == "both" {
        let tail = dist.cdf(stat);
        if tail > 0.5 {
            return 2.0 * (1.0 - tail);
        } else {
            return 2.0 * tail;
        }
    }
    if alternative == "less" || alternative == "left" {
        return dist.cdf(stat);
    }
    if alternative == "greater" || alternative == "right" {
        return 1.0 - dist.cdf(stat);
    }
    // Default to two-sided if unrecognized
    let tail = dist.cdf(stat);
    if tail > 0.5 {
        return 2.0 * (1.0 - tail);
    } else {
        return 2.0 * tail;
    }
}

// ----------------------------------------------------------------------------
// Inferencia: z-Test (One Sample)
// ----------------------------------------------------------------------------

struct ZTestResult {
    statistic: f64,
    p_value: f64,
    estimate: f64,
    std_error: f64,
    conf_low: f64,
    conf_high: f64,
    method: String,
    df_table: DataFrame
}

impl ZTestResult {
    fn tidy(&self) -> DataFrame {
        return self.df_table;
    }

    fn glance(&self) -> DataFrame {
        return self.df_table;
    }
}

fn z_test_one_sample(x: any, mu: any, sigma: any) -> ZTestResult {
    let n = length(x);
    let m = mean(x);
    let se = sigma / sqrt(n);
    let stat = (m - mu) / se;
    let norm = normal(0.0, 1.0);
    let p_val = p_value(stat, norm, "two_sided");
    let ci = conf_int(m, se, norm, 0.95);

    let df_table = dataframe {
        estimate: [m],
        statistic: [stat],
        p_value: [p_val],
        std_error: [se],
        conf_low: [ci.conf_low],
        conf_high: [ci.conf_high]
    };

    return ZTestResult {
        statistic: stat,
        p_value: p_val,
        estimate: m,
        std_error: se,
        conf_low: ci.conf_low,
        conf_high: ci.conf_high,
        method: "One-sample z-test",
        df_table: df_table
    };
}

// ----------------------------------------------------------------------------
// Inferencia: Pearson Correlation Test (`cor_test`)
// ----------------------------------------------------------------------------

struct CorTestResult {
    estimate: f64,
    statistic: f64,
    p_value: f64,
    df: f64,
    conf_low: f64,
    conf_high: f64,
    method: String,
    df_table: DataFrame
}

impl CorTestResult {
    fn tidy(&self) -> DataFrame {
        return self.df_table;
    }

    fn glance(&self) -> DataFrame {
        return self.df_table;
    }
}

fn cor_test(x: any, y: any) -> CorTestResult {
    let n = length(x);
    let mx = mean(x);
    let my = mean(y);
    let dx = x - mx;
    let dy = y - my;
    let num = sum(dx * dy);
    let den = sqrt(sum(dx * dx) * sum(dy * dy));
    let r = num / den;
    let df = n - 2.0;
    let t_stat = r * sqrt(df) / sqrt(1.0 - r * r);
    let t_dist = student_t(df);
    let p_val = p_value(t_stat, t_dist, "two_sided");

    // Fisher z-transformation for Pearson r confidence interval
    let z = 0.5 * log((1.0 + r) / (1.0 - r));
    let se_z = 1.0 / sqrt(n - 3.0);
    let norm = normal(0.0, 1.0);
    let crit = norm.quantile(0.975);
    let z_low = z - crit * se_z;
    let z_high = z + crit * se_z;
    let r_low = (exp(2.0 * z_low) - 1.0) / (exp(2.0 * z_low) + 1.0);
    let r_high = (exp(2.0 * z_high) - 1.0) / (exp(2.0 * z_high) + 1.0);

    let df_table = dataframe {
        estimate: [r],
        statistic: [t_stat],
        p_value: [p_val],
        df: [df],
        conf_low: [r_low],
        conf_high: [r_high]
    };

    return CorTestResult {
        estimate: r,
        statistic: t_stat,
        p_value: p_val,
        df: df,
        conf_low: r_low,
        conf_high: r_high,
        method: "Pearson product-moment correlation",
        df_table: df_table
    };
}
