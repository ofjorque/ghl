// CLBG Spectral Norm Benchmark in Pure GHL
// Measures power iteration performance on an infinite Hilbert-like matrix:
// A(i, j) = 1.0 / ((i + j) * (i + j + 1) / 2 + i + 1)

println("=== CLBG Benchmark: Spectral Norm (Power Iteration) ===");

let n = 50;

fn eval_a(i: f64, j: f64) -> f64 {
    1.0 / (((i + j) * (i + j + 1.0)) * 0.5 + i + 1.0)
}

println("Computing spectral norm for N =", n, "with 10 power iterations...");
let t0 = clock_now();

let mut u = zeros(n) + 1.0;
let mut v = zeros(n);

let mut it = 0;
while it < 10 {
    // v = A * u
    let mut new_v = zeros(n);
    let mut i = 0;
    while i < n {
        let mut s = 0.0;
        let mut j = 0;
        while j < n {
            s = s + eval_a(i * 1.0, j * 1.0) * u[j];
            j = j + 1;
        };
        new_v = set(new_v, i, s);
        i = i + 1;
    };
    v = new_v;

    // u = A^T * v
    let mut new_u = zeros(n);
    let mut i2 = 0;
    while i2 < n {
        let mut s2 = 0.0;
        let mut j2 = 0;
        while j2 < n {
            s2 = s2 + eval_a(j2 * 1.0, i2 * 1.0) * v[j2];
            j2 = j2 + 1;
        };
        new_u = set(new_u, i2, s2);
        i2 = i2 + 1;
    };
    u = new_u;

    it = it + 1;
};

let vBv = dot(u, v);
let vv = dot(v, v);
let norm = sqrt(vBv / vv);

let t1 = clock_now();
println("Computed Spectral Norm:", norm);
println("Spectral Norm Duration (seconds):", t1 - t0);

// Spectral norm of Hilbert-like matrix at N=100
pounce(norm > 1.0 && norm < 1.5, "spectral norm matches positive eigenvalue bound");
println("(=^･ω･^=) Spectral Norm benchmark passed!");
